<footer class="w-full mx-auto mt-16 pb-0 md:pt-8">
  <ul
    class="
      flex gap-8 items-center mb-4 text-sm font-medium sm:mb-0 justify-center
      md:justify-end
    "
  >
    <li>
      <%= link_to t("about"), about_path, class: "hover:underline" %>
    </li>
    <li>
      <%= link_to t("contact"), contact_path, class: "hover:underline" %>
    </li>
  </ul>
  <hr class="my-6 border-neutral-400 dark:border-neutral-700 sm:mx-auto lg:my-8"/>
  <div class="text-center">
    <%= t("made_with") %>
    ❤️
    <%= t("city_of_origin") %><%= Time.zone.now.year %>
    🛹
  </div>
</footer>
