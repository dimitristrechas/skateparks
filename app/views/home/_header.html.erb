<header
  data-controller="header"
  class="flex items-center mb-8 md:mb-16 gap-4 md:gap-8"
>
  <%= link_to root_path, class: ''  do %>
    <%= image_tag("skateparks-logo-transparent.png", alt: "skateparks.gr logo", class: "h-36 w-auto", data: { header_target: "lightLogo" }) %>
    <%= image_tag("skateparks-logo-transparent-dark-mode.png", alt: "skateparks.gr logo", class: "h-36 w-auto hidden", data: { header_target: "darkLogo" }) %>
  <% end %>

  <%= render "home/locale_selector" %>

  <%= render "home/dark_mode_switch" %>
</header>
