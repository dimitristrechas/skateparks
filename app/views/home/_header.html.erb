<header data-controller="header" class="flex items-start mb-4 md:mb-6">
  <%= link_to root_path, class: ''  do %>
    <%= image_tag(
      "skateparks-logo.png",
      alt: "skateparks.gr logo",
        class: "h-24 md:h-32 w-auto dark:drop-shadow-[0_0_3px_rgba(255,255,255,1)]",
    ) %>
  <% end %>

  <div class="flex item ms-auto gap-4 md:gap-8">
    <%= render "home/locale_selector" %>
    <%= render "home/dark_mode_switch" %>
  </div>
</header>
