<header data-controller="header" class="flex justify-between items-center mb-16 gap-8">
    <%= link_to root_path do %>
      <%= image_tag("skateparks_logo_universal.svg",
                    height: "43",
                    width: "377",
                    alt: "skateparks.gr logo",
                  ) %>
    <% end %>

    <%= render(
      LinkComponent.new(
        title: "Admin",
        url: admin_skateparks_path,
        classnames: 'ms-auto'
      )
    ) if ENV["RAILS_ENV"] == 'development' %>

    <%= render "home/locale_selector" %>

    <%= render "home/dark_mode_switch" %>
</header>
