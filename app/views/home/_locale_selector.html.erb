<nav aria-label="Language selector" class="flex place-items-center">
  <ul class="flex gap-4">
    <% I18n.available_locales.each do |locale| %>
      <li>
        <% selected = LOCALES[I18n.locale] === LOCALES[locale] %>

        <%= link_to LOCALES[locale],
                    {
                      locale: locale,
                      country_code: params[:country_code],
                      state: params[:state],
                      page: params[:page],
                    }.compact,
                    class: "#{selected ? 'outline rounded-lg outline-gray-200 bg-gray-200 dark:outline-gray-800 dark:bg-gray-800':'hover:outline rounded-lg dark:hover:outline-gray-800 dark:hover:bg-gray-800 hover:outline-gray-200 hover:bg-gray-200'} py-2 px-4" %>
      </li>
    <% end %>
  </ul>
</nav>
