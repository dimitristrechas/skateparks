<% unless Rails.env.production? %>
  <nav aria-label="<%= t("home.developer_navigation.aria_label") %>" class="flex place-items-center">
    <ul class="flex sm:gap-4">
      <li>
        <%= render LinkComponent.new(
          title: t("home.developer_navigation.admin"),
          url: admin_root_path,
          classnames: "inline-flex items-center min-h-8 min-w-8",
          current: request.path.start_with?("/admin"),
        ) %>
      </li>

      <% if defined?(Lookbook) %>
        <li>
          <%= render LinkComponent.new(
            title: t("home.developer_navigation.lookbook"),
            url: lookbook_path,
            classnames: "inline-flex items-center min-h-8 min-w-8",
            current: request.path.start_with?("/lookbook"),
          ) %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
