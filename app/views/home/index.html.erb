<div class="grid grid-cols-1 xl:grid-cols-2 gap-8 place-items-center">
  <% @skateparks.each do |skatepark| %>
    <%= link_to skatepark_path(skatepark.id),
                class: "flex flex-col items-stretch bg-white border border-gray-200 rounded-lg hover:drop-shadow-md md:flex-row dark:border-gray-700 dark:bg-gray-800" do %>
      <%= image_tag skatepark.cover_image,
                    size: "600x450",
                    class: "object-cover w-full md:h-auto md:w-3/5 -skew-y-2 hover:brightness-105 rounded-lg origin-center shadow-lg",
                    alt: "#{skatepark.name} cover image" %>
      <div class="flex flex-1 flex-col justify-start p-8 leading-normal">
        <h5 class="mb-3 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
          <%= skatepark.name %>
        </h5>
        <p class="mb-1 font-normal text-gray-700 dark:text-gray-400">
          <%= "#{skatepark.images.size} #{t('photos')}" %>
        </p>
    
      </div>
    <% end %>
  <% end %>

  <div class="flex flex-col items-center bg-white border border-gray-200 rounded-lg shadow md:flex-row dark:border-gray-700 dark:bg-gray-800 h-full w-full opacity-40">
    <svg class="w-1/2 h-1/2 text-gray-800 dark:text-white -skew-y-2 origin-center" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 18">
      <path d="M18 0H2a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2Zm-5.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm4.376 10.481A1 1 0 0 1 16 15H4a1 1 0 0 1-.895-1.447l3.5-7A1 1 0 0 1 7.468 6a.965.965 0 0 1 .9.5l2.775 4.757 1.546-1.887a1 1 0 0 1 1.618.1l2.541 4a1 1 0 0 1 .028 1.011Z"/>
    </svg>
    <div class="flex flex-col justify-between p-8 leading-normal self-start">
      <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
        <%= t('more_skateparks_soon') %>
      </h5>
      <p class="mb-3 font-normal text-gray-700 dark:text-gray-400"></p>
    </div>
  </div>
</div>