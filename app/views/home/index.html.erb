<div class="mb-12">
  <%= render(TitleComponent.new(title: "Welcome!")) %>
</div>

<div class="grid grid-cols-3 gap-4">
<% @skateparks.each do |skatepark| %>

  <figure class="relative cursor-pointer hover:drop-shadow-md">

    <%= link_to skatepark_path(skatepark.id) do %>
      <%= image_tag skatepark.cover_image,
                    size: "600x450",
                    class: "rounded",
                    alt: "#{skatepark.name} cover image" %>
    <% end %>

    <figcaption class="bg-neutral-900 text-neutral-50 opacity-90 absolute px-8 pt-1 pb-2 text-2xl font-semibold bottom-4 rounded-r">
      <%= skatepark.name %>
    </figcaption>
  </figure>
<% end %>
</div>