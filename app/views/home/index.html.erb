<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 place-items-center">
  <% @skateparks.each do |skatepark| %>
    <%= link_to skatepark_path(skatepark),
                class: "flex flex-col items-stretch bg-neutral-50 border border-gray-200 rounded-lg hover:drop-shadow-md md:flex-row dark:border-gray-700 dark:bg-gray-800" do %>
      <%= image_tag skatepark.cover_image,
                    size: "600x450",
                    class: "object-cover w-full md:h-auto md:w-3/5 -skew-y-1 origin-bottom-left rounded-lg shadow-lg",
                    alt: "#{skatepark.name} cover image" %>
      <div class="flex flex-1 overflow-hidden flex-col justify-between sm:justify-start items-start p-4 sm:py-8 sm:ps-6 leading-normal">
        <h5 class="sm:mb-3 text-2xl lg:max-xl:text-xl xl:text-2xl font-bold tracking-tight text-neutral-700 dark:text-neutral-200">
          <%= skatepark.name %>
        </h5>
        <p class="sm:mb-1 font-normal">
          <%= "#{skatepark.images.size} #{t('photos')}" %>
        </p>
        <svg class="w-6 h-6 sm:mt-auto self-end hover:w-7 hover:h-7 transition-all" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 16 16">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 1h4m0 0v4m0-4-5 5.243M5 15H1m0 0v-4m0 4 5.243-5"/>
        </svg>  
      </div>
    <% end %>
  <% end %>

  <%= link_to about_path,
              class: "flex flex-col items-center bg-neutral-50 border border-gray-200 rounded-lg shadow md:flex-row dark:border-gray-700 dark:bg-gray-800 h-full w-full p-8 sm:p-4 opacity-80 dark:opacity-50" do %>
    <svg class="w-1/2 h-1/2 text-neutral-700 dark:text-neutral-200 -skew-y-2 origin-center" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 18">
      <path d="M18 0H2a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2Zm-5.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3Zm4.376 10.481A1 1 0 0 1 16 15H4a1 1 0 0 1-.895-1.447l3.5-7A1 1 0 0 1 7.468 6a.965.965 0 0 1 .9.5l2.775 4.757 1.546-1.887a1 1 0 0 1 1.618.1l2.541 4a1 1 0 0 1 .028 1.011Z"/>
    </svg>
    <h5 class="text-2xl font-bold tracking-tight text-neutral-700 dark:text-neutral-200 self-start mt-8">
      <%= t('more_skateparks_soon') %>
    </h5>
  <% end %>
</div>