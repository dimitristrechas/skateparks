<%= render GoSkateDayCountdownComponent.new %>

<h1 class="mb-8 text-center text-lg sm:text-3xl font-bold lg:mb-8"><%= t("explore_all_skateparks") %></h1>

<section class="mb-12 lg:mb-20 flex items-center justify-center gap-2">
  <%= render LinkButtonComponent.new(
    title: t("view_all_skateparks"),
    url: skateparks_path,
    large: true,
    contained: true
  ) %>
</section>

<section class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16 xl:grid-cols-3">
  <% @skateparks_latest.each do |skatepark| %>
    <%= render(HomepageSkateparkCardComponent.new(skatepark: skatepark, badge_type: :new)) %>
  <% end %>

  <% @skateparks_popular.each do |skatepark| %>
    <%= render(HomepageSkateparkCardComponent.new(skatepark: skatepark, badge_type: :popular)) %>
  <% end %>
</section>
