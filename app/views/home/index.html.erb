

<div id="skateparks">
  <% @skateparks.each do |skatepark| %>
    <%= render skatepark %>

    <p class='mb-3'>
      <%= render(
        LinkComponent.new(
          title: "Show this skatepark",
          url: skatepark_path(skatepark.id),
          classNames: "text-blue-700 underline",
        )
      ) %>
    </p>
  <% end %>
</div>