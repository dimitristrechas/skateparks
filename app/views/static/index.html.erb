<header><%= link_to 'admin dashboard', admin_skateparks_path, class: 'text-blue-500 underline' %></header>

<h1 class="text-3xl font-bold mt-3 mb-6">Welcome to skateparks.gr</h1>



<div id="skateparks">
  <% @skateparks.each do |skatepark| %>
    <%= render skatepark %>
    <p class='mb-3'>
      <%= link_to "Show this skatepark", skatepark_path(skatepark.id) %>
    </p>
  <% end %>
</div>