<header><%= link_to 'admin dashboard', admin_skateparks_path %></header>

<main>
<h1>Welcome to skateparks.gr</h1>



<div id="skateparks">
  <% @skateparks.each do |skatepark| %>
    <%= render skatepark %>
    <p>
      <%= link_to "Show this skatepark", admin_skatepark_path(skatepark.id) %>
    </p>
  <% end %>
</div>
</main>