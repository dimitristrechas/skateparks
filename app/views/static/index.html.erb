<header><%= link_to 'admin dashboard', admin_skateparks_path, class: 'text-blue-700 underline' %></header>

<%= image_tag("skateparks_logo_dark.svg", height: '161', width: '834', alt: 'skateparks.gr logo') %>

<div id="skateparks">
  <% @skateparks.each do |skatepark| %>
    <%= render skatepark %>

    <p class='mb-3'>
      <%= render(
        LinkComponent.new(
          title: "Show this skatepark",
          url: skatepark_path(skatepark.id),
          classNames: "text-blue-700 underline",
        )
      ) %>
    </p>
  <% end %>
</div>