<header data-controller="header"
        data-header-logo-dark-url-value="<%= image_path("skateparks_logo_dark.svg") %>"
        data-header-logo-light-url-value="<%= image_path("skateparks_logo_light.svg") %>"
        class="flex justify-between items-start">
  <%= image_tag("skateparks_logo_dark.svg",
                height: "161",
                width: "834",
                alt: "skateparks.gr logo",
                data: { "header-target": "image" }
              ) %>
  <%= render "static/header/dark_mode_switch" %>
</header>
