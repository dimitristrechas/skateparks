<div data-controller="admin--video-suggestions">
  <p style="color: green"><%= notice %></p>

  <% if alert.present? %>
    <p class="mb-4 text-red-600 dark:text-red-400" role="alert"><%= alert %></p>
  <% end %>

  <div class="mb-8 flex items-center justify-between gap-4">
    <h1 class="text-3xl font-bold"><%= t("admin.video_suggestions.title") %></h1>

    <% pending_count = @video_suggestions.total_count %>

    <% if pending_count.positive? %>
      <span class="rounded-full bg-pink-600/85 px-3 py-1 text-sm text-white dark:bg-pink-600/65">
        <%= t("admin.video_suggestions.pending_count", count: pending_count) %>
      </span>
    <% end %>
  </div>

  <% if @video_suggestions.total_pages > 1 %>
    <%= link_to t("skip_to_pagination"), "#skatepark-pagination", class: "skip-link" %>
  <% end %>

  <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
    <table class="text-md w-full text-left text-gray-500 rtl:text-right dark:text-gray-400">
      <thead class="bg-gray-50 text-sm text-gray-700 dark:bg-gray-700 dark:text-gray-400">
        <tr>
          <th scope="col" class="px-6 py-3"><%= t("admin.video_suggestions.thumbnail") %></th>
          <th scope="col" class="px-6 py-3"><%= t("admin.video_suggestions.proposed_for") %></th>
          <th scope="col" class="px-6 py-3"><%= t("admin.video_suggestions.assign_to") %></th>
          <th scope="col" class="px-6 py-3"><%= t("admin.video_suggestions.url") %></th>
          <th scope="col" class="px-6 py-3"><%= t("admin.video_suggestions.submitted_at") %></th>
          <th scope="col" class="px-6 py-3"><%= t("admin.video_suggestions.actions") %></th>
        </tr>
      </thead>

      <tbody>
        <% if @video_suggestions.empty? %>
          <tr class="border-b bg-white dark:border-gray-700 dark:bg-gray-900">
            <td colspan="6" class="px-6 py-4 text-center"><%= t("admin.video_suggestions.empty_state") %></td>
          </tr>
        <% else %>
          <% @video_suggestions.each do |video_suggestion| %>
            <% activate_form_id = dom_id(video_suggestion, :activate) %>
            <% proposed_park = video_suggestion.proposed_skatepark || video_suggestion.skatepark %>

            <tr
              id="<%= dom_id(video_suggestion) %>"
              class="
                border-b odd:bg-white even:bg-gray-50 dark:border-gray-700 odd:dark:bg-gray-900
                even:dark:bg-gray-800
              "
            >
              <td class="px-6 py-4">
                <%= image_tag video_suggestion.thumbnail_url,
                              alt: t("admin.video_suggestions.thumbnail_alt"),
                              class: "h-[60px] w-[80px] rounded object-cover" %>
              </td>

              <td class="px-6 py-4 font-medium text-gray-900 dark:text-white">
                <%= link_to proposed_park.name,
                            edit_admin_skatepark_path(proposed_park),
                            class: "hover:underline" %>
              </td>

              <td class="px-6 py-4">
                <input
                  type="hidden"
                  id="<%= dom_id(video_suggestion, :skatepark_id) %>"
                  name="skatepark_id"
                  value="<%= video_suggestion.skatepark_id %>"
                  form="<%= activate_form_id %>"
                  data-assigned-skatepark-input
                >

                <div class="flex flex-wrap items-center gap-2">
                  <span
                    id="<%= dom_id(video_suggestion, :assigned_skatepark_name) %>"
                    class="font-medium text-gray-900 dark:text-white"
                    data-assigned-skatepark-name
                  >
                    <%= video_suggestion.skatepark.name %>
                  </span>

                  <button
                    type="button"
                    class="
                      inline-flex min-h-8 min-w-8 cursor-pointer items-center rounded-lg px-2.5 py-1 text-xs
                      font-medium text-neutral-700 outline outline-gray-400 transition hover:outline-offset-1
                      hover:outline-neutral-700 focus-visible:outline focus-visible:outline-offset-1
                      focus-visible:outline-neutral-700 dark:text-neutral-200 dark:outline-gray-500
                      dark:hover:outline-neutral-200 dark:focus-visible:outline-neutral-200
                    "
                    data-action="click->admin--video-suggestions#openReassignModal"
                    data-video-suggestion-id="<%= dom_id(video_suggestion) %>"
                    data-skatepark-id="<%= video_suggestion.skatepark_id %>"
                    data-skatepark-name="<%= video_suggestion.skatepark.name %>"
                  >
                    <%= t("admin.video_suggestions.change_skatepark") %>
                    <span class="sr-only">(<%= proposed_park.name %>)</span>
                  </button>
                </div>
              </td>

              <td class="px-6 py-4">
                <p class="max-w-xs truncate"><%= video_suggestion.youtube_url %></p>
              </td>

              <td class="px-6 py-4 whitespace-nowrap"><%= l(video_suggestion.created_at, format: :short) %></td>

              <td class="px-6 py-4">
                <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                  <%= form_with url: activate_admin_video_suggestion_path(video_suggestion),
                                method: :post,
                                id: activate_form_id,
                                class: "contents" do |activate_form| %>
                    <%= activate_form.submit t("admin.video_suggestions.activate"),
                                             class: "cursor-pointer rounded-lg bg-green-600 px-3 py-2 text-sm text-white hover:bg-green-700" %>
                  <% end %>

                  <%= button_to t("admin.video_suggestions.reject"),
                                reject_admin_video_suggestion_path(video_suggestion),
                                method: :post,
                                form: { data: { turbo_confirm: t("admin.video_suggestions.reject_confirm") } },
                                class: "text-red-500 hover:underline" %>
                </div>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= paginate @video_suggestions, window: 1, outer_window: 1 %>

  <dialog
    id="reassign-skatepark-dialog"
    class="
      fixed top-1/2 left-1/2 max-h-[calc(100%-2rem)] w-[min(100%,32rem)] -translate-x-1/2 -translate-y-1/2
      overflow-visible rounded-lg border border-neutral-200 bg-white p-0 shadow-xl backdrop:bg-neutral-950/60
      dark:border-neutral-700 dark:bg-neutral-800
    "
    data-admin--video-suggestions-target="dialog"
    aria-labelledby="reassign-skatepark-dialog-title"
  >
    <div class="p-4">
      <div class="mb-2 flex items-center justify-between gap-4">
        <h2 id="reassign-skatepark-dialog-title" class="text-xl font-semibold text-neutral-900 dark:text-white">
          <%= t("admin.video_suggestions.reassign_dialog_title") %>
        </h2>

        <button
          type="button"
          class="
            inline-flex size-11 cursor-pointer items-center justify-center rounded-lg text-neutral-600 transition
            hover:outline-2 hover:outline-offset-2 hover:outline-neutral-700 focus-visible:outline-2
            focus-visible:outline-offset-2 focus-visible:outline-neutral-700 dark:text-neutral-300
            dark:hover:outline-neutral-200 dark:focus-visible:outline-neutral-200
          "
          data-action="click->admin--video-suggestions#closeReassignModal"
          aria-label="<%= t('admin.video_suggestions.close_dialog') %>"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="size-5">
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18 18 6m0 12L6 6"
            />
          </svg>
        </button>
      </div>

      <p class="mb-4 text-sm text-neutral-600 dark:text-neutral-300">
        <%= t("admin.video_suggestions.reassign_dialog_description") %>
      </p>

      <div class="mb-6">
        <%= render(
          Admin::SkateparkPickerComponent.new(
            input_name: "modal_skatepark_id",
            input_id: "modal_skatepark_id",
            label: t("admin.video_suggestions.assign_to"),
            search_url: search_admin_skateparks_path,
          ),
        ) %>
      </div>

      <div class="flex justify-end gap-3">
        <button
          type="button"
          class="
            inline-flex min-h-8 min-w-8 cursor-pointer items-center rounded-lg px-4 py-2 text-neutral-700 transition
            hover:outline hover:outline-offset-1 hover:outline-neutral-700 focus-visible:outline
            focus-visible:outline-offset-1 focus-visible:outline-neutral-700 dark:text-neutral-200
            dark:hover:outline-neutral-200 dark:focus-visible:outline-neutral-200
          "
          data-action="click->admin--video-suggestions#closeReassignModal"
        >
          <%= t("cancel") %>
        </button>

        <%= render(
          ButtonComponent.new(
            title: t("admin.video_suggestions.reassign_confirm"),
            type: "button",
            data: { action: "click->admin--video-suggestions#applyReassignment" },
          ),
        ) %>
      </div>
    </div>
  </dialog>
</div>

<%= render(
  LinkComponent.new(
    title: t("back_to_admin"),
    url: admin_root_path,
    classnames:
      "flex flex-col sm:flex-row my-8 gap-4 items-center sm:items-start justify-end",
  ),
) %>
