<div class="mb-8 flex items-center justify-between">
  <h1 class="text-3xl font-bold"><%= t('admin.dashboard.title') %></h1>
  <%= button_to t('admin.sign_out'), session_path, method: :delete, class: "inline-flex items-center rounded-lg px-3 min-h-8 min-w-8 hover:outline hover:outline-offset-1 hover:outline-neutral-700 hover:dark:outline-neutral-200 focus-visible:outline focus-visible:outline-offset-1 focus-visible:outline-neutral-700 focus-visible:dark:outline-neutral-200 cursor-pointer bg-pink-600/85 text-white dark:bg-pink-600/65 dark:text-white" %>
</div>

<div class="flex flex-col gap-4 md:flex-row">
  <%= render LinkButtonComponent.new(
      title: t('admin.dashboard.manage_skateparks'),
      url: admin_skateparks_path,
      large: true,
      ghost: true
    ) %>

  <%= render LinkButtonComponent.new(
      title: t('admin.dashboard.manage_popular_skateparks'),
      url: admin_popular_skateparks_path,
      large: true,
      ghost: true
    ) %>

  <%= render LinkButtonComponent.new(
      title: t('admin.dashboard.manage_video_suggestions'),
      url: admin_video_suggestions_path,
      large: true,
      ghost: true
    ) do |button| %>
    <% button.with_icon_after do %>
      <%= render CounterBubbleComponent.new(
            count: @pending_video_suggestions_count,
            label: t('admin.dashboard.video_suggestions_count', count: @pending_video_suggestions_count)
          ) %>
    <% end %>
  <% end %>

  <%= render LinkButtonComponent.new(
      title: t('admin.dashboard.manage_site_announcements'),
      url: admin_site_announcements_path,
      large: true,
      ghost: true
    ) do |button| %>
    <% button.with_icon_after do %>
      <%= render CounterBubbleComponent.new(
            count: @visible_site_announcements_count,
            label: t('admin.dashboard.site_announcements_count', count: @visible_site_announcements_count)
          ) %>
    <% end %>
  <% end %>

  <%= render LinkButtonComponent.new(
      title: t('admin.users.title'),
      url: admin_users_path,
      large: true,
      ghost: true
    ) %>

  <%= render LinkButtonComponent.new(
      title: t('admin.dashboard.view_account'),
      url: account_profile_path,
      large: true,
      ghost: true
    ) %>
</div>
