<%= form_with(url: skatepark&.id ? admin_skatepark_path(skatepark) : admin_skateparks_path,
              model: skatepark,
              class: "my-8",
              data: {
                controller: 'admin--skateparks--form',
                admin__skateparks__form_confirm_delete_value: t('admin.skateparks.form.confirm_delete'),
                admin__skateparks__form_confirm_delete_video_value: t('admin.skateparks.form.confirm_delete_video'),
                admin__skateparks__form_image_alt_pattern_value: t('admin.skateparks.form.image_alt', position: '{position}'),
                admin__skateparks__form_reorder_pattern_value: t('admin.skateparks.form.reorder_image', position: '{position}'),
                admin__skateparks__form_delete_pattern_value: t('admin.skateparks.form.delete_image', position: '{position}'),
                admin__skateparks__form_move_up_pattern_value: t('admin.skateparks.form.move_image_up', position: '{position}'),
                admin__skateparks__form_move_down_pattern_value: t('admin.skateparks.form.move_image_down', position: '{position}'),
                admin__skateparks__form_image_moved_pattern_value: t('admin.skateparks.form.image_moved', position: '{position}', total: '{total}'),
                admin__skateparks__form_image_removed_value: t('admin.skateparks.form.image_removed'),
                admin__skateparks__form_new_image_removed_value: t('admin.skateparks.form.new_image_removed'),
                admin__skateparks__form_images_added_one_value: t('admin.skateparks.form.images_added_one'),
                admin__skateparks__form_images_added_other_value: t('admin.skateparks.form.images_added_other', count: '{count}'),
                admin__skateparks__form_video_alt_pattern_value: t('admin.skateparks.form.video_thumbnail_alt',
                                                                   position: '{position}'),
                admin__skateparks__form_reorder_video_pattern_value: t('admin.skateparks.form.reorder_video',
                                                                       position: '{position}'),
                admin__skateparks__form_delete_video_pattern_value: t('admin.skateparks.form.delete_video',
                                                                      position: '{position}'),
                admin__skateparks__form_move_video_up_pattern_value: t('admin.skateparks.form.move_video_up',
                                                                       position: '{position}'),
                admin__skateparks__form_move_video_down_pattern_value: t('admin.skateparks.form.move_video_down',
                                                                         position: '{position}'),
                admin__skateparks__form_video_moved_pattern_value: t('admin.skateparks.form.video_moved',
                                                                     position: '{position}', total: '{total}'),
                admin__skateparks__form_video_removed_value: t('admin.skateparks.form.video_removed'),
                admin__skateparks__form_new_video_removed_value: t('admin.skateparks.form.new_video_removed'),
                admin__skateparks__form_video_added_value: t('admin.skateparks.form.video_added'),
                admin__skateparks__form_invalid_video_url_value: t('admin.skateparks.form.invalid_video_url'),
                admin__skateparks__form_duplicate_video_url_value: t('admin.skateparks.form.duplicate_video_url'),
              }) do |form| %>
  <% if skatepark.errors.any? %>
    <div class="mb-4">
      <h2 class="mb-1 text-xl font-semibold"><%= t("admin.skateparks.form.errors_title") %></h2>

      <ul class="list-inside list-disc text-red-600">
        <% skatepark.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-8">
    <div class="flex flex-col gap-2">
      <%= render(TextFieldComponent.new(name: "name_el", title: t("skatepark.name_el"), form: form)) %>
      <%= render(TextFieldComponent.new(name: "name_en", title: t("skatepark.name_en"), form: form)) %>
    </div>

    <div class="flex flex-col gap-2">
      <%= render(
        TextFieldComponent.new(
          name: "lat",
          title: t("skatepark.latitude"),
          form: form,
          classnames: "col-start-1",
        ),
      ) %>

      <%= render(TextFieldComponent.new(name: "lng", title: t("skatepark.longitude"), form: form)) %>
    </div>

    <%= render(
      TextFieldComponent.new(
        name: "google_id",
        title: t("skatepark.google_id"),
        form: form,
      ),
    ) %>

    <div class="flex flex-col gap-2">
      <%= form.label :status %>

      <%= form.select :status,
                  Skatepark.statuses.keys.map { |key| [key.humanize, key] },
                  { selected: skatepark.status || :draft },
                  { class: "p-1 text-neutral-600 dark:text-neutral-700" } %>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :country_code,
                 t("country"),
                 class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>

      <%= form.select :country_code,
                  [["", ""]] +
                    ISO3166::Country.all.map { |c| [c.common_name, c.alpha2] },
                  { selected: skatepark.country_code },
                  {
                    class: "p-1 text-neutral-600 dark:text-neutral-700",
                    data: {
                      admin__skateparks__form_target: "countrySelect",
                      action: "change->admin--skateparks--form#onCountryChange",
                    },
                  } %>
    </div>

    <div class="flex flex-col gap-2">
      <%= form.label :state,
                 t("country_state"),
                 class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>

      <%= form.select :state,
                  skatepark.country&.subdivisions&.map { |code, subdivision|
                    [subdivision.name, code]
                  } || [["", ""]],
                  { selected: skatepark.state },
                  {
                    disabled: skatepark.country_code.blank?,
                    class: "p-1 text-neutral-600 dark:text-neutral-700",
                    data: {
                      admin__skateparks__form_target: "stateSelect",
                    },
                  } %>
    </div>

    <div class="col-start-1">
      <%= form.label :description_el,
                 t("skatepark.description_el"),
                 class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>

      <%= form.rich_text_area(:description_el, class: "bg-white text-neutral-600") %>
    </div>

    <div>
      <%= form.label :description_en,
                 t("skatepark.description_en"),
                 class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>

      <%= form.rich_text_area(:description_en, class: "bg-white text-neutral-600") %>
    </div>

    <div class="col-span-2">
      <h3 class="text-lg font-semibold"><%= t("admin.skateparks.form.seo_heading") %></h3>
      <p class="mb-4 text-sm text-neutral-600 dark:text-neutral-400"><%= t("admin.skateparks.form.seo_hint") %></p>
    </div>

    <div class="col-span-2 flex flex-col gap-2 sm:col-span-1">
      <%= render(TextFieldComponent.new(name: "meta_title_el", title: t("skatepark.meta_title_el"), form: form)) %>
      <%= render(TextFieldComponent.new(name: "meta_description_el", title: t("skatepark.meta_description_el"), form: form)) %>
    </div>

    <div class="col-span-2 flex flex-col gap-2 sm:col-span-1">
      <%= render(TextFieldComponent.new(name: "meta_title_en", title: t("skatepark.meta_title_en"), form: form)) %>
      <%= render(TextFieldComponent.new(name: "meta_description_en", title: t("skatepark.meta_description_en"), form: form)) %>
    </div>

    <div class="col-start-1">
      <%= form.label :cover_image,
                 t("skatepark.cover_image"),
                 class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>

      <%= form.file_field :cover_image,
                      multiple: false,
                      accept: "image/*",
                      class: "p-1 text-neutral-600 dark:text-neutral-300" %>
    </div>

    <div class="col-span-2 flex flex-wrap place-items-center gap-4">
      <% if skatepark&.id && skatepark.cover_image.attached? %>
        <%= image_tag skatepark.cover_image,
                  size: "600x450",
                  class: "rounded",
                  alt: t("skatepark.cover_image_alt", name: skatepark.name) %>
      <% end %>
    </div>

    <div class="col-start-1">
      <%= form.label :new_images,
                 t("skatepark.images"),
                 class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>

      <%= form.file_field :new_images,
                      multiple: true,
                      accept: "image/*",
                      class: "p-1 text-neutral-600 dark:text-neutral-300",
                      data: {
                        admin__skateparks__form_target: "newImagesInput",
                        action: "change->admin--skateparks--form#onNewImagesChange",
                      } %>

      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400">
        <%= t("admin.skateparks.form.images_upload_hint") %>
      </p>
    </div>

    <div class="col-span-2 space-y-4">
      <div
        class="sr-only"
        aria-live="polite"
        aria-atomic="true"
        data-admin--skateparks--form-target="announcement"
      ></div>

      <div
        class="
          divide-y divide-neutral-200 overflow-hidden rounded-lg border border-neutral-300 dark:divide-gray-700
          dark:border-neutral-600
        "
        data-admin--skateparks--form-target="sortableList"
        role="list"
        aria-label="<%= t("admin.skateparks.form.images_aria_label") %>"
      >
        <% persisted_skatepark_images =
             skatepark.skatepark_images.select(&:persisted?).sort_by do |image_record|
               [image_record.position || Float::INFINITY, image_record.id || Float::INFINITY]
             end %>

        <p
          class="
            <%= class_names('bg-white p-4 text-sm text-neutral-500 dark:bg-gray-900 dark:text-neutral-400',
            'hidden' => persisted_skatepark_images.any?) %>
          "
          data-admin--skateparks--form-target="emptyState"
        >
          <%= t("admin.skateparks.form.images_empty_state") %>
        </p>

        <% persisted_skatepark_images.each_with_index do |skatepark_image, index| %>
          <%= form.fields_for :skatepark_images, skatepark_image do |image_fields| %>
            <% marked_for_destruction = image_fields.object.marked_for_destruction? %>

            <%= render(Admin::SortableListItemComponent.new(resource_type: :image,
                                                            index: index,
                                                            destroyed: marked_for_destruction)) do |item| %>
              <% item.with_fields do %>
                <%= image_fields.hidden_field :id %>

                <%= image_fields.hidden_field :position,
                                          value: image_fields.object.position,
                                          data: { position_field: true } %>

                <%= image_fields.hidden_field :_destroy,
                                          value: (marked_for_destruction ? 1 : 0),
                                          data: { destroy_field: true } %>
              <% end %>

              <% item.with_preview do %>
                <%= image_tag skatepark_image.image,
                            size: "80x60",
                            alt: t("admin.skateparks.form.image_alt", position: index + 1),
                            class: "h-[60px] w-[80px] rounded object-cover",
                            data: { item_preview: true } %>
              <% end %>

              <% item.with_subtitle do %>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  <%= t("admin.skateparks.form.drag_to_reorder_hint") %>
                </p>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <template data-admin--skateparks--form-target="newImageTemplate">
        <%= render(Admin::SortableListItemComponent.new(resource_type: :image)) do |item| %>
          <% item.with_fields do %>
            <input
              type="hidden"
              name="skatepark[new_image_positions][]"
              value=""
              data-position-field
            >
          <% end %>

          <% item.with_preview do %>
            <img
              alt="<%= t("admin.skateparks.form.new_image_preview_alt") %>"
              class="h-[60px] w-[80px] rounded object-cover"
              data-item-preview
            >
          <% end %>

          <% item.with_subtitle do %>
            <p class="truncate text-sm text-neutral-500 dark:text-neutral-400" data-file-name></p>
          <% end %>
        <% end %>
      </template>
    </div>

    <div class="col-start-1">
      <label for="new-video-url-input" class="mb-1 block text-neutral-600 dark:text-neutral-300">
        <%= t("admin.skateparks.form.video_url") %>
      </label>

      <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
        <input
          id="new-video-url-input"
          type="text"
          inputmode="url"
          placeholder="<%= t("admin.skateparks.form.video_url_placeholder") %>"
          class="w-full rounded p-2 text-neutral-600 sm:flex-1"
          autocomplete="url"
          data-admin--skateparks--form-target="newVideoUrlInput"
          data-action="keydown.enter->admin--skateparks--form#addVideo input->admin--skateparks--form#clearVideoUrlError"
        >

        <button
          type="button"
          class="
            inline-flex min-h-11 cursor-pointer items-center rounded-lg bg-pink-600/85 px-4 py-2 text-white
            transition hover:outline hover:outline-offset-1 hover:outline-neutral-700 focus-visible:outline
            focus-visible:outline-offset-1 focus-visible:outline-neutral-700 dark:bg-pink-600/65
            dark:hover:outline-neutral-200 dark:focus-visible:outline-neutral-200
          "
          data-action="click->admin--skateparks--form#addVideo"
        >
          <%= t("admin.skateparks.form.add_video") %>
        </button>
      </div>

      <p
        id="new-video-url-error"
        class="mt-2 hidden text-sm text-red-600 dark:text-red-400"
        aria-live="polite"
        aria-atomic="true"
        data-admin--skateparks--form-target="newVideoUrlError"
      ></p>

      <p class="mt-2 text-sm text-neutral-500 dark:text-neutral-400"><%= t("admin.skateparks.form.videos_hint") %></p>
    </div>

    <div class="col-span-2 space-y-4">
      <% persisted_skatepark_videos =
           skatepark.skatepark_videos.select(&:persisted?).sort_by do |video_record|
             [
               video_record.active? ? 0 : 1,
               video_record.active? ? (video_record.position || Float::INFINITY) : 0,
               video_record.id || Float::INFINITY,
             ]
           end %>

      <div
        class="
          divide-y divide-neutral-200 overflow-hidden rounded-lg border border-neutral-300 dark:divide-gray-700
          dark:border-neutral-600
        "
        data-admin--skateparks--form-target="sortableVideoList"
        role="list"
        aria-label="<%= t("admin.skateparks.form.videos_aria_label") %>"
      >
        <p
          class="
            <%= class_names('bg-white p-4 text-sm text-neutral-500 dark:bg-gray-900 dark:text-neutral-400',
            'hidden' => persisted_skatepark_videos.any?) %>
          "
          data-admin--skateparks--form-target="emptyVideoState"
        >
          <%= t("admin.skateparks.form.videos_empty_state") %>
        </p>

        <% persisted_skatepark_videos.each_with_index do |skatepark_video, index| %>
          <%= form.fields_for :skatepark_videos, skatepark_video do |video_fields| %>
            <% marked_for_destruction = video_fields.object.marked_for_destruction? %>

            <%= render(Admin::SortableListItemComponent.new(resource_type: :video,
                                                            index: index,
                                                            destroyed: marked_for_destruction)) do |item| %>
              <% item.with_fields do %>
                <%= video_fields.hidden_field :id %>

                <%= video_fields.hidden_field :position,
                                         value: video_fields.object.position,
                                         data: { position_field: true } %>

                <%= video_fields.hidden_field :_destroy,
                                         value: (marked_for_destruction ? 1 : 0),
                                         data: { destroy_field: true } %>

                <%= video_fields.select :status,
                                    SkateparkVideo.statuses.keys.map { |status|
                                      [t("admin.skateparks.form.video_statuses.#{status}"), status]
                                    },
                                    {},
                                    class: "mt-2 w-full rounded border-neutral-300 p-1 text-sm text-neutral-600 sm:max-w-xs dark:border-neutral-600 dark:bg-gray-800 dark:text-neutral-200" %>
              <% end %>

              <% item.with_preview do %>
                <%= image_tag skatepark_video.thumbnail_url,
                          alt: t("admin.skateparks.form.video_thumbnail_alt", position: index + 1),
                          class: "h-[60px] w-[80px] rounded object-cover",
                          data: { item_preview: true } %>
              <% end %>

              <% item.with_subtitle do %>
                <p class="truncate text-sm text-neutral-500 dark:text-neutral-400" data-video-url-label>
                  <%= skatepark_video.youtube_url %>
                </p>

                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  <% if skatepark_video.active? %>
                    <%= t("admin.skateparks.form.drag_to_reorder_hint") %>
                  <% else %>
                    <%= t("admin.skateparks.form.video_statuses.#{skatepark_video.status}") %>
                  <% end %>
                </p>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <template data-admin--skateparks--form-target="newVideoTemplate">
        <%= render(Admin::SortableListItemComponent.new(resource_type: :video)) do |item| %>
          <% item.with_fields do %>
            <input
              type="hidden"
              name="skatepark[new_video_urls][]"
              value=""
              data-video-url-field
            >

            <input
              type="hidden"
              name="skatepark[new_video_positions][]"
              value=""
              data-position-field
            >
          <% end %>

          <% item.with_preview do %>
            <img
              alt="<%= t("admin.skateparks.form.new_video_thumbnail_alt") %>"
              class="h-[60px] w-[80px] rounded object-cover"
              data-item-preview
            >
          <% end %>

          <% item.with_subtitle do %>
            <p class="truncate text-sm text-neutral-500 dark:text-neutral-400" data-video-url-label></p>

            <p class="text-sm text-neutral-500 dark:text-neutral-400">
              <%= t("admin.skateparks.form.drag_to_reorder_hint") %>
            </p>
          <% end %>
        <% end %>
      </template>
    </div>

    <div class="col-span-2 justify-self-end">
      <%= render(
        ButtonComponent.new(
          title: skatepark&.id ? t("edit") : t("create"),
          form: form,
          type: "submit",
          large: true,
        ),
      ) %>
    </div>
  </div>
<% end %>
