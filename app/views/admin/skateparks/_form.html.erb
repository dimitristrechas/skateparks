<%= form_with(url: skatepark&.id ? admin_skatepark_path(skatepark.id) : admin_skateparks_path,
              model: skatepark,
              class: "my-8",
              data: {
                controller: 'admin--skateparks--form'
              }) do |form| %>

  <% if skatepark.errors.any? %>
    <div class="mb-4">
      <h2 class="text-xl font-semibold mb-1">Errors</h2>
      <ul class="list-inside list-disc text-red-600">
        <% skatepark.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-2 gap-8">
    <div class="flex flex-col gap-2">
      <%= render(
        TextFieldComponent.new(
          name: 'name_el',
          title: 'Name greek',
          form: form
        )
      ) %>
      <%= render(
        TextFieldComponent.new(
          name: 'name_en',
          title: 'Name english',
          form: form
        )
      ) %>
    </div>

    <div class="flex flex-col gap-2">
      <%= render(
        TextFieldComponent.new(
          name: 'lat',
          title: 'Latitude',
          form: form,
          classnames: 'col-start-1'
        )
      ) %>
      <%= render(
        TextFieldComponent.new(
          name: 'lng',
          title: 'Longitude',
          form: form
        )
      ) %>
    </div>

    <%= render(
      TextFieldComponent.new(
        name: 'google_id',
        title: 'Google maps id',
        form: form
      )
    ) %>

    <div class="col-start-1">
      <%= form.label :description_el, 'Description el', class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>
      <%= form.rich_text_area(:description_el, class: 'bg-white text-neutral-600') %>
    </div>

    <div>
      <%= form.label :description_en, 'Description en', class: "block text-neutral-600 dark:text-neutral-300 mb-1" %>
      <%= form.rich_text_area(:description_en, class: 'bg-white text-neutral-600') %>
    </div>

    <div class="col-start-1">
      <%= form.label :cover_image, 'Cover image', class: "block text-neutral-600 dark:text-neutral-300  mb-1" %>

      <%= form.file_field :cover_image,
                          multiple: false,
                          accept:'image/*',
                          class: "p-1 text-neutral-600 dark:text-neutral-300" %>
    </div>

    <div class="flex gap-4 col-span-2 flex-wrap place-items-center">
      <% if skatepark&.id %>
        <%= image_tag skatepark.cover_image,
                      size: "600x450",
                      class: "rounded" %>
      <% end %>
    </div>

    <div class="col-start-1">
      <%= form.label :images, 'Skatepark images', class: "block text-neutral-600 dark:text-neutral-300  mb-1" %>
      <%= form.file_field :images,
                          multiple: true,
                          accept:'image/*',
                          class: "p-1 text-neutral-600 dark:text-neutral-300" %>
    </div>

    <div class="flex gap-4 col-span-2 flex-wrap place-items-center">
      <% if skatepark&.id %>
        <% skatepark.images.each do |image| %>
          <div
            data-action="click->admin--skateparks--form#onImageClick"
            class="cursor-pointer hover:outline hover:outline-4 hover:outline-offset-2 hover:outline-red-500 rounded"
          >
            <%= form.hidden_field :images,
                                  multiple: true,
                                  value: image.signed_id %>
            <%= image_tag image,
                          size: "200x150",
                          class: "rounded" %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="col-span-2 justify-self-end">
      <%= render(
        ButtonComponent.new(
          title: skatepark&.id ? t('edit') : t('create'),
          form: form,
          type: 'submit'
        )
      ) %>
    </div>
  </div>
<% end %>
