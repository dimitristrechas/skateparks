<p style="color: green"><%= notice %></p>

<%= render(TitleComponent.new(title: "List of skateparks")) %>

<div class="my-4 flex flex-row-reverse">
  <%= render(LinkComponent.new(title: "New skatepark", url: new_admin_skatepark_path)) %>
</div>

<div class="relative overflow-x-auto shadow-md sm:rounded-lg">
  <table class="text-md w-full text-left text-gray-500 rtl:text-right dark:text-gray-400">
    <thead class="bg-gray-50 text-sm text-gray-700 dark:bg-gray-700 dark:text-gray-400">
      <tr>
        <th scope="col" class="px-6 py-3"><%= t("skatepark.name") %></th>
        <th scope="col" class="px-6 py-3"><%= t("skatepark.images") %></th>
        <th scope="col" class="px-6 py-3"><%= t("skatepark.status") %></th>
        <th scope="col" class="px-6 py-3"><%= t("skatepark.google_id") %></th>
        <th scope="col" class="px-6 py-3"></th>
      </tr>
    </thead>

    <tbody>
      <% @skateparks.each do |skatepark| %>
        <tr class="border-b odd:bg-white even:bg-gray-50 dark:border-gray-700 odd:dark:bg-gray-900 even:dark:bg-gray-800">
          <th scope="row" class="px-6 py-4 font-medium whitespace-nowrap text-gray-900 dark:text-white">
            <%= skatepark.name %>
          </th>

          <td class="px-6 py-4"><%= skatepark.images.size %></td>
          <td class="px-6 py-4"><%= skatepark.status %></td>
          <td class="px-6 py-4"><%= skatepark.google_id.present? %></td>

          <td class="flex gap-4 px-6 py-4">
            <%= render(
              LinkComponent.new(title: "edit", url: edit_admin_skatepark_path(skatepark)),
            ) %>

            <%= if Rails.env.development?
              button_to "destroy",
              admin_skatepark_path(skatepark),
              method: :delete,
              form: {
                data: {
                  turbo_confirm: t("delete_confirm"),
                },
              },
              class: "text-red-500 hover:underline"
            end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
