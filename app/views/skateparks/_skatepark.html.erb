<div id="<%= dom_id skatepark %>">
  <h2 class="text-2xl text-neutral-600 dark:text-neutral-300 font-semibold mb-4">
    <%= skatepark.name %>
  </h2>

  <div class="flex align-center gap-x-2 text-neutral-600 dark:text-neutral-300 mb-2">
    <span>Latitude: <%= skatepark.lat %></span>
    <span>Longitude: <%= skatepark.lng %></span>
  </div>
  <div>
    <%= skatepark.description %>
  </div>
  <div class="grid grid-cols-4 gap-4">
    <% skatepark.images.each_with_index do |image, index| %>
      <div class="<%= index == 0 ? 'col-span-2': '' %>">
        <%= image_tag image,
                      class: "w-full h-auto",
                      srcset: [
                        [url_for(image.variant(:sm)), "400w"],
                        [url_for(image.variant(:md)), "1200w"],
                        [url_for(image.variant(:lg)), "1600w"]
                      ],
                      sizes: "100vw" %>
      </div>
    <% end %>
  </div>
</div>


