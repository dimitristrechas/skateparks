<div
  id="<%= dom_id skatepark %>"
  data-controller="skatepark"
  data-skatepark-lat-value="<%= skatepark.lat %>"
  data-skatepark-lng-value="<%= skatepark.lng %>"
>

  <%= render(TitleComponent.new(title: skatepark.name, classnames: "mb-4 sm:mb-6")) %>

  <div class="flex mb-6 sm:mb-8">
    <%= skatepark.description %>
  </div>

  <div
    class="
      flex flex-col sm:flex-row gap-4 items-center sm:items-start justify-center
      sm:justify-center mb-6 sm:mb-8
    "
  >
    <%= link_to skatepark.google_id.nil? ?
                  "https://www.google.com/maps/search/?api=1&query=#{skatepark.lat},#{skatepark.lng}" :
                  "https://maps.app.goo.gl/#{skatepark.google_id}",
                target: "_blank",
                class: "flex items-center justify-center p-3 md:p-5 text-base font-medium rounded-lg bg-white hover:text-gray-900 hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:hover:text-white" do %>
      <svg
        aria-hidden="true"
        class="me-3 w-6 h-6 md:w-[32px] md:h-[32px]"
        xmlns="http://www.w3.org/2000/svg"
        fill="currentColor"
        viewBox="0 0 16 20"
      >
        <path
          d="M8 0a7.992 7.992 0 0 0-6.583 12.535 1 1 0 0 0 .12.183l.12.146c.112.145.227.285.326.4l5.245 6.374a1 1 0 0 0 1.545-.003l5.092-6.205c.206-.222.4-.455.578-.7l.127-.155a.934.934 0 0 0 .122-.192A8.001 8.001 0 0 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
        />
      </svg>
      <span class="w-full text-center"><%= t("open_in_google_maps") %></span>
    <% end %>
  </div>

  <div
    class="
      grid grid-cols-3 auto-rows-[8rem] md:auto-rows-[14rem] xl:auto-rows-[20rem]
      lg:grid-cols-4 gap-1 mb-6 sm:mb-8
    "
  >
    <% skatepark.images.each_with_index do |image, index| %>
      <div class="hover:opacity-50 hover:cursor-pointer">
        <%= cl_image_tag image.key,
        width: 400,
        height: 400,
        id: "previewImage-#{index}",
        class: "h-full w-full object-cover",
        loading: index < 5 ? "eager" : "lazy",
        srcset:
          "#{cloudinary_url(image.key, width: 245, height: 245, **CLOUDINARY_DEFAULT_SETTINGS)} 320w, " \
            "#{cloudinary_url(image.key, width: 400, height: 400, **CLOUDINARY_DEFAULT_SETTINGS)} 640w, " \
            "#{cloudinary_url(image.key, width: 600, height: 600, **CLOUDINARY_DEFAULT_SETTINGS)} 1600w",
        sizes: "(max-width: 640px) 320px, 100vw",
        data: {
          "skatepark-target": "previewImage",
          action: "click->skatepark#onImageClick",
        } %>
      </div>
    <% end %>
  </div>

  <div
    class="
      hidden fixed inset-0 py-16 px-4 md:py-16 lg:py-24 md:px-16 lg:px-24 z-10
      bg-neutral-700/80
    "
    data-skatepark-target="gallery"
  >
    <!-- Close modal icon -->
    <svg
      class="
        w-8 h-8 lg:w-12 lg:h-12 absolute top-4 right-2 md:top-8 md:right-8 lg:top-12
        lg:right-12 text-white font-bold cursor-pointer
      "
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      data-action="click->skatepark#onModalClose"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18 18 6m0 12L6 6"
      />
    </svg>
    <!-- Close modal icon --> <!-- Previous gallery image icon -->
    <svg
      class="
        hidden sm:block w-14 h-14 absolute top-1/2 left-2 lg:left-6 text-white font-bold
        cursor-pointer
      "
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="none"
      viewBox="0 0 24 24"
      data-action="click->skatepark#onPreviousGalleryImage"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m15 19-7-7 7-7"
      />
    </svg>
    <!-- Previous gallery image icon -->
    <div
      class="
        relative flex flex-col items-center justify-between gap-2 bg-white rounded-lg
        overflow-hidden py-8 px-4 h-full w-full
      "
    >
      <!-- Gallery images icon -->
      <% skatepark.images.each_with_index do |image, index| %>
        <%= cl_image_tag image.key,
        id: "galleryImage-#{index}",
        quality: :auto,
        fetch_format: :auto,
        class: "hidden object-contain w-full h-[92%]",
        loading: "lazy",
        data: {
          "skatepark-target": "galleryImage",
        } %>
      <% end %>
      <!-- Gallery images icon --> <!-- Slider indicators -->
      <div class="flex flex-wrap justify-center gap-2 items-center">
        <% skatepark.images.each_with_index do |_, index| %>
          <div
            class="w-3 h-3 bg-gray-400 rounded-full opacity-25 cursor-pointer"
            id="<%= "indicatorImage-#{index}" %>"
            data-action="click->skatepark#onGalleryImageIndicatorClick"
            data-skatepark-target="galleryImageIndicator"
          ></div>
        <% end %>
      </div>
      <!-- Slider controls -->
    </div>
    <!-- Next gallery image icon -->
    <svg
      class="
        hidden sm:block w-14 h-14 absolute top-1/2 right-2 lg:right-6 text-white
        font-bold cursor-pointer
      "
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="none"
      viewBox="0 0 24 24"
      data-action="click->skatepark#onNextGalleryImage"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m9 5 7 7-7 7"
      />
    </svg>
    <!-- Next gallery image icon -->
  </div>

  <div class="hidden sm:block">
    <div
      data-skatepark-target="container"
      class="leaflet-container rounded-lg z-0"
      style="min-height: 450px"
    >
    </div>
  </div>
</div>
