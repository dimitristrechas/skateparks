<div id="<%= dom_id skatepark %>">

  <%= render(TitleComponent.new(title: skatepark.name, classnames: 'mb-4 sm:mb-6')) %>

  <div id="default-carousel" class="relative w-full mb-2 sm:mb-8" data-carousel="slide">
    <div class="relative overflow-hidden rounded-lg h-96 md:h-128">
      <% skatepark.images.each_with_index do |image, index| %>
        <div class="hidden duration-1000 ease-in-out" data-carousel-item>
          <%= cl_image_tag image.key,
                           width: 1600,
                           height: 1200,
                           class: "absolute block w-full -translate-x-1/2 -translate-y-1/2 top-1/2 left-1/2 rounded-lg",
                           loading: index < 5 ? 'eager' : 'lazy',
                           srcset: "#{cloudinary_url(image.key, width: 600, height: 450, **CLOUDINARY_DEFAULT_SETTINGS)} 320w, " \
                                   "#{cloudinary_url(image.key, width: 1200, height: 900, **CLOUDINARY_DEFAULT_SETTINGS)} 640w, " \
                                   "#{cloudinary_url(image.key, width: 1600, height: 1200, **CLOUDINARY_DEFAULT_SETTINGS)} 1600w",
                           sizes: "(max-width: 640px) 320px, 100vw" %>
        </div>
      <% end %>
    </div>
    <!-- Slider indicators -->
    <div class="absolute z-30 -translate-x-1/2 hidden md:flex bottom-5 left-1/2 space-x-3 rtl:space-x-reverse">
      <% skatepark.images.each_with_index do |image, index| %>
        <button type="button"
                class="w-3 h-3 rounded-full"
                aria-current="true" aria-label="Slide <%= index %>"
                data-carousel-slide-to="<%= index %>">

        </button>
      <% end %>
    </div>
    <!-- Slider controls -->
    <button type="button"
            class="absolute top-0 start-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
            data-carousel-prev>
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 dark:bg-gray-800/30 group-hover:bg-white/50 dark:group-hover:bg-gray-800/60 group-focus:ring-4 group-focus:ring-white dark:group-focus:ring-gray-800/70 group-focus:outline-none">
        <svg class="w-4 h-4 text-white dark:text-gray-800 rtl:rotate-180"
             aria-hidden="true"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 6 10">
          <path stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 1 1 5l4 4"/>
        </svg>
        <span class="sr-only"><%= t('previous') %></span>
      </span>
    </button>
    <!-- Slider controls -->
    <button type="button"
            class="absolute top-0 end-0 z-30 flex items-center justify-center h-full px-4 cursor-pointer group focus:outline-none"
            data-carousel-next>
      <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-white/30 dark:bg-gray-800/30 group-hover:bg-white/50 dark:group-hover:bg-gray-800/60 group-focus:ring-4 group-focus:ring-white dark:group-focus:ring-gray-800/70 group-focus:outline-none">
        <svg class="w-4 h-4 text-white dark:text-gray-800 rtl:rotate-180"
             aria-hidden="true"
             xmlns="http://www.w3.org/2000/svg"
             fill="none"
             viewBox="0 0 6 10">
          <path stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m1 9 4-4-4-4"/>
        </svg>
        <span class="sr-only"><%= t('next') %></span>
      </span>
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 place-content-start gap-8">
    <div data-controller="skatepark"
        data-skatepark-target="container"
        data-skatepark-lat-value="<%= skatepark.lat %>"
        data-skatepark-lng-value="<%= skatepark.lng %>"
        class="leaflet-container rounded-lg hidden sm:block"
        style="min-height: 450px">
    </div>

    <div class="flex flex-col">
      <h5 class="font-semibold text-xl mb-2"><%= t('description') %></h5>
      <%= skatepark.description %>
    </div>

    <div class="flex flex-col sm:flex-row gap-4 items-center sm:items-start justify-end sm:justify-start">
      <%= link_to skatepark.google_id.nil? ?
                    "https://www.google.com/maps/search/?api=1&query=#{skatepark.lat},#{skatepark.lng}" :
                    "https://maps.app.goo.gl/#{skatepark.google_id}",
                  target: "_blank",
                  class: "flex items-center justify-center p-5 text-base font-medium rounded-lg bg-white hover:text-gray-900 hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:hover:text-white" do %>
        <svg aria-hidden="true"
            class="me-3 w-[32px] h-[32px]"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 16 20">
          <path d="M8 0a7.992 7.992 0 0 0-6.583 12.535 1 1 0 0 0 .12.183l.12.146c.112.145.227.285.326.4l5.245 6.374a1 1 0 0 0 1.545-.003l5.092-6.205c.206-.222.4-.455.578-.7l.127-.155a.934.934 0 0 0 .122-.192A8.001 8.001 0 0 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/>
        </svg>
        <span class="w-full text-center"><%= t('open_in_google_maps') %></span>
      <% end %>
    </div>
  </div>
</div>


