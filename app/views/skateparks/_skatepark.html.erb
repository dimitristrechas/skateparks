<div id="<%= dom_id skatepark %>"
     data-controller="skatepark"
     data-skatepark-lat-value="<%= skatepark.lat %>"
     data-skatepark-lng-value="<%= skatepark.lng %>">

  <%= render(TitleComponent.new(title: skatepark.name, classnames: 'mb-4 sm:mb-6')) %>

  <div class="flex mb-6 sm:mb-8">
    <%= skatepark.description %>
  </div>

  <div class="flex flex-col sm:flex-row gap-4 items-center sm:items-start justify-center sm:justify-center mb-6 sm:mb-8">
    <%= link_to skatepark.google_id.nil? ?
                  "https://www.google.com/maps/search/?api=1&query=#{skatepark.lat},#{skatepark.lng}" :
                  "https://maps.app.goo.gl/#{skatepark.google_id}",
                target: "_blank",
                class: "flex items-center justify-center p-5 text-base font-medium rounded-lg bg-white hover:text-gray-900 hover:bg-gray-50 dark:bg-gray-800 dark:hover:bg-gray-700 dark:hover:text-white" do %>
      <svg aria-hidden="true"
          class="me-3 w-[32px] h-[32px]"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 16 20">
        <path d="M8 0a7.992 7.992 0 0 0-6.583 12.535 1 1 0 0 0 .12.183l.12.146c.112.145.227.285.326.4l5.245 6.374a1 1 0 0 0 1.545-.003l5.092-6.205c.206-.222.4-.455.578-.7l.127-.155a.934.934 0 0 0 .122-.192A8.001 8.001 0 0 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"/>
      </svg>
      <span class="w-full text-center"><%= t('open_in_google_maps') %></span>
    <% end %>
  </div>

  <div class="grid grid-cols-3 lg:grid-cols-4 gap-1 mb-6 sm:mb-8">
    <% skatepark.images.each_with_index do |image, index| %>
      <div class="hover:opacity-50 hover:cursor-pointer">
        <%= cl_image_tag image.key,
                          width: 400,
                          height: 400,
                          id: "previewImage-#{index}",
                          class: "",
                          loading: index < 5 ? 'eager' : 'lazy',
                          srcset: "#{cloudinary_url(image.key, width: 245, height: 245, **CLOUDINARY_DEFAULT_SETTINGS)} 320w, " \
                                  "#{cloudinary_url(image.key, width: 400, height: 400, **CLOUDINARY_DEFAULT_SETTINGS)} 640w, " \
                                  "#{cloudinary_url(image.key, width: 600, height: 600, **CLOUDINARY_DEFAULT_SETTINGS)} 1600w",
                          sizes: "(max-width: 640px) 320px, 100vw",
                          data: {
                            "skatepark-target": "previewImage",
                            "action": "click->skatepark#onImageClick"
                          }
                        %>
      </div>
    <% end %>
  </div>

  <div class="hidden fixed inset-0 py-14 px-4 z-10 bg-neutral-700/80"
       data-skatepark-target="gallery">
    <svg class="w-8 h-8 absolute top-2 right-2 text-white font-bold cursor-pointer"
         aria-hidden="true"
         xmlns="http://www.w3.org/2000/svg"
         fill="none"
         viewBox="0 0 24 24"
         data-action="click->skatepark#onModalClose">
      <path stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18 18 6m0 12L6 6"/>
    </svg>
    <div class="relative bg-white rounded-lg overflow-hidden pt-8 pb-14 px-4 h-full w-full box-border">
    
        <% skatepark.images.each_with_index do |image, index| %>
            <%= cl_image_tag image.key,
                             id: "galleryImage-#{index}",
                             quality: :auto,
                             fetch_format: :auto,
                             class: "hidden object-contain w-full h-full",
                             loading: 'lazy',
                             data: {
                               "skatepark-target": "galleryImage"
                             } %>
        <% end %>
      
    </div>
  </div>

  <div class="hidden sm:block">
    <div data-skatepark-target="container"
         class="leaflet-container rounded-lg z-0"
         style="min-height: 450px">
    </div>
  </div>
</div>


