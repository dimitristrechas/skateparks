<div id="<%= dom_id skatepark %>">
  <h2 class="text-2xl text-neutral-600 dark:text-neutral-300 font-semibold mb-4">
    <%= skatepark.name %>
  </h2>

  <div class="flex align-center gap-x-2 text-neutral-600 dark:text-neutral-300 mb-2">
    <span>Latitude: <%= skatepark.lat %></span>
    <span>Longitude: <%= skatepark.lng %></span>
  </div>
  <div class="grid grid-cols-2 gap-8">
    <% skatepark.images.each do |image| %>
      <div><%= image_tag image, class: "w-full h-auto" %></div>
    <% end %>
  </div>
</div>


