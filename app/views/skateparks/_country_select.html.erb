<div class="flex flex-col items-start gap-1" id="country_select">
  <%= label_tag :country_code, t("country"), class: "block" %>

  <%= render SelectComponent.new(
    name: :country_code,
    options: [[t("all_countries"), ""]] + countries.map { |c| [c.translations[I18n.locale], c.alpha2] },
    selected: params[:country_code],
    large: true,
    data: { "skateparks--filters-target": "countrySelect" }
  ) %>
</div>
