<div class="flex flex-col items-start gap-1" id="state_select">
  <%= label_tag :state, t("country_state"), class: "block" %>

  <%= render SelectComponent.new(
    name: :state,
    options: [[t("all_states"), ""]] + states.map { |s| [s.translations[I18n.locale], s.code] },
    selected: params[:state],
    disabled: states.empty?,
    large: true
  ) %>
</div>
