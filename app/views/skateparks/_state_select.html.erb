<div class="flex flex-col items-start gap-1" id="state_select">
  <%= label_tag :state, t("country_state"), class: "block" %>

  <%= select_tag :state,
  options_for_select(
    [[t("all_states"), ""]] +
      states.map { |s| [s.translations[I18n.locale], s.code] },
    params[:state],
  ),
  {
    disabled: states.empty?,
    class:
      "w-56 bg-gray-50 border border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 block p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:focus:ring-blue-500 dark:focus:border-blue-500",
  } %>
</div>
