<% content_for :head do %>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@2.0.0-alpha.1/dist/leaflet.css"
    integrity="sha384-mduptj5Hiyp/jSH2p+p4A8UdSz0gnkrO1y37pdMuUTkAMEUuDsr12k7o4eQJXufp"
    crossorigin
  >
<% end %>

<div
  id="<%= dom_id @skatepark %>"
  data-controller="skatepark"
  data-skatepark-lat-value="<%= @skatepark.lat %>"
  data-skatepark-lng-value="<%= @skatepark.lng %>"
>
  <h1 class="mb-8 text-3xl font-bold"><%= @skatepark.name %></h1>

  <div class="mb-6 flex sm:mb-8"><span><%= @location_friendly_name %></span></div>

  <div class="mb-6 flex sm:mb-8"><%= @skatepark.description %></div>

  <div class="mb-6 flex flex-col items-center justify-center gap-4 sm:mb-8 sm:flex-row sm:items-start sm:justify-center">
    <% skatepark_url = @skatepark.google_id.blank? ?
         "https://www.google.com/maps/search/?api=1&query=#{@skatepark.lat},#{@skatepark.lng}" :
         "https://maps.app.goo.gl/#{@skatepark.google_id}" %>

    <%= render(LinkButtonComponent.new(
      title: t("open_in_google_maps"),
      url: skatepark_url,
      ghost: true,
      target: "_blank",
      large: true
    )) do |c| %>
      <% c.with_icon_before do %>
        <svg
          aria-hidden="true"
          class="h-6 w-6 md:h-8 md:w-8"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 16 20"
        >
          <path
            d="M8 0a7.992 7.992 0 0 0-6.583 12.535 1 1 0 0 0 .12.183l.12.146c.112.145.227.285.326.4l5.245 6.374a1 1 0 0 0 1.545-.003l5.092-6.205c.206-.222.4-.455.578-.7l.127-.155a.934.934 0 0 0 .122-.192A8.001 8.001 0 0 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
          />
        </svg>
      <% end %>
    <% end %>
  </div>

  <div class="mb-6 grid auto-rows-[8rem] grid-cols-3 gap-1 sm:mb-8 md:auto-rows-[14rem] lg:grid-cols-4 xl:auto-rows-[20rem]">
    <% @skatepark.images.each_with_index do |image, index| %>
      <div class="hover:cursor-pointer hover:opacity-50">
        <%= cl_image_tag image.key,
        width: 400,
        height: 400,
        id: "previewImage-#{index}",
        class: "h-full w-full object-cover",
        loading: index < 5 ? "eager" : "lazy",
        srcset:
          "#{cloudinary_url(image.key, width: 245, height: 245, **CLOUDINARY_DEFAULT_SETTINGS)} 320w, " \
            "#{cloudinary_url(image.key, width: 400, height: 400, **CLOUDINARY_DEFAULT_SETTINGS)} 640w, " \
            "#{cloudinary_url(image.key, width: 600, height: 600, **CLOUDINARY_DEFAULT_SETTINGS)} 1600w",
        sizes: "(max-width: 640px) 320px, 100vw",
        data: {
          "skatepark-target": "previewImage",
          action: "click->skatepark#onImageClick",
        } %>
      </div>
    <% end %>
  </div>

  <div
    class="fixed inset-0 z-10 hidden bg-neutral-700/80 px-4 py-16 md:px-16 md:py-16 lg:px-24 lg:py-24"
    data-skatepark-target="gallery"
  >
    <svg
      class="absolute top-4 right-2 size-8 cursor-pointer md:top-8 md:right-8 lg:top-12 lg:right-12 lg:size-12"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      data-action="click->skatepark#onModalClose"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18 18 6m0 12L6 6"
      />
    </svg>

    <svg
      class="absolute top-1/2 left-2 hidden h-14 w-14 cursor-pointer sm:block lg:left-6"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="none"
      viewBox="0 0 24 24"
      data-action="click->skatepark#onPreviousGalleryImage"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m15 19-7-7 7-7"
      />
    </svg>

    <div
      class="
        relative flex h-full w-full flex-col items-center justify-between gap-2 overflow-hidden rounded-lg bg-white
        px-4 py-8
      "
    >
      <% @skatepark.images.each_with_index do |image, index| %>
        <%= cl_image_tag image.key,
        id: "galleryImage-#{index}",
        quality: :auto,
        fetch_format: :auto,
        class: "hidden object-contain w-full h-[92%]",
        loading: "lazy",
        data: {
          "skatepark-target": "galleryImage",
        } %>
      <% end %>

      <div class="flex flex-wrap items-center justify-center gap-2">
        <% @skatepark.images.each_with_index do |_, index| %>
          <div
            class="h-3 w-3 cursor-pointer rounded-full bg-gray-400 opacity-25"
            id="<%= "indicatorImage-#{index}" %>"
            data-action="click->skatepark#onGalleryImageIndicatorClick"
            data-skatepark-target="galleryImageIndicator"
          ></div>
        <% end %>
      </div>
    </div>

    <svg
      class="absolute top-1/2 right-2 hidden h-14 w-14 cursor-pointer sm:block lg:right-6"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      fill="none"
      viewBox="0 0 24 24"
      data-action="click->skatepark#onNextGalleryImage"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="m9 5 7 7-7 7"
      />
    </svg>
  </div>

  <div class="hidden sm:block">
    <div data-skatepark-target="container" class="leaflet-container z-0 rounded-lg" style="min-height: 450px"></div>
  </div>
</div>

<%= render(
  LinkComponent.new(
    title: t("back_to_skateparks"),
    url: skateparks_path,
    classnames:
      "flex flex-col sm:flex-row my-8 gap-4 items-center sm:items-start justify-end",
  ),
) %>
