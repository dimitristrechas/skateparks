<% content_for :head do %>
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@2.0.0-alpha.1/dist/leaflet.css"
    integrity="sha384-mduptj5Hiyp/jSH2p+p4A8UdSz0gnkrO1y37pdMuUTkAMEUuDsr12k7o4eQJXufp"
    crossorigin
  >
<% end %>

<div
  id="<%= dom_id @skatepark %>"
  data-controller="skatepark"
  data-skatepark-lat-value="<%= @skatepark.lat %>"
  data-skatepark-lng-value="<%= @skatepark.lng %>"
>
  <% skatepark_images = @skatepark.skatepark_images %>
  <% skatepark_videos = @skatepark.active_skatepark_videos %>

  <h1 class="mb-8 text-3xl font-bold"><%= @skatepark.name %></h1>

  <div class="mb-6 flex sm:mb-8"><span><%= @location_friendly_name %></span></div>

  <div class="mb-6 flex sm:mb-8"><%= @skatepark.description %></div>

  <div class="mb-6 flex flex-col items-center justify-center gap-4 sm:mb-8 sm:flex-row sm:items-start sm:justify-center">
    <% skatepark_url = @skatepark.google_id.blank? ?
         "https://www.google.com/maps/search/?api=1&query=#{@skatepark.lat},#{@skatepark.lng}" :
         "https://maps.app.goo.gl/#{@skatepark.google_id}" %>

    <%= render(LinkButtonComponent.new(
      title: t("open_in_google_maps"),
      url: skatepark_url,
      ghost: true,
      target: "_blank",
      large: true
    )) do |c| %>
      <% c.with_icon_before do %>
        <svg
          aria-hidden="true"
          class="h-6 w-6 md:h-8 md:w-8"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 16 20"
        >
          <path
            d="M8 0a7.992 7.992 0 0 0-6.583 12.535 1 1 0 0 0 .12.183l.12.146c.112.145.227.285.326.4l5.245 6.374a1 1 0 0 0 1.545-.003l5.092-6.205c.206-.222.4-.455.578-.7l.127-.155a.934.934 0 0 0 .122-.192A8.001 8.001 0 0 0 8 0Zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z"
          />
        </svg>
      <% end %>
    <% end %>
  </div>

  <% photos_grid = capture do %>
    <div class="mb-6 grid auto-rows-[8rem] grid-cols-3 gap-1 sm:mb-8 md:auto-rows-[14rem] lg:grid-cols-4 xl:auto-rows-[20rem]">
      <% skatepark_images.each_with_index do |skatepark_image, index| %>
        <button
          type="button"
          id="previewImage-<%= index %>"
          role="img"
          class="
            cursor-pointer overflow-hidden transition-opacity hover:opacity-50 focus-visible:outline
            focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-neutral-700
            dark:focus-visible:outline-neutral-200
          "
          data-skatepark-target="previewImage"
          data-action="click->skatepark#onImageClick"
          aria-label="<%= t('view_image_in_gallery', number: index + 1) %>"
        >
          <%= cl_image_tag skatepark_image.image.key,
          width: 400,
          height: 400,
          class: "h-full w-full object-cover",
          loading: index < 5 ? "eager" : "lazy",
          srcset:
            "#{cloudinary_url(skatepark_image.image.key, width: 245, height: 245, **CLOUDINARY_DEFAULT_SETTINGS)} 320w, " \
              "#{cloudinary_url(skatepark_image.image.key, width: 400, height: 400, **CLOUDINARY_DEFAULT_SETTINGS)} 640w, " \
              "#{cloudinary_url(skatepark_image.image.key, width: 600, height: 600, **CLOUDINARY_DEFAULT_SETTINGS)} 1600w",
          sizes: "(max-width: 640px) 320px, 100vw",
          alt: "" %>
        </button>
      <% end %>
    </div>
  <% end %>

  <% videos_panel = capture do %>
    <%= render "skateparks/videos_grid", skatepark: @skatepark, skatepark_videos: skatepark_videos %>
  <% end %>

  <div
    class="mb-6 sm:mb-8"
    data-controller="skatepark-tabs skatepark-video-suggestion"
    data-skatepark-tabs-default-tab-value="photos"
    data-skatepark-video-suggestion-invalid-video-url-value="<%= t('skateparks.video_suggestion.invalid_url') %>"
  >
    <div
      class="mb-4 flex items-center gap-6 border-b border-neutral-200 dark:border-neutral-700"
      role="tablist"
      aria-label="<%= t("skatepark.media_tabs") %>"
    >
      <button
        id="photos-tab"
        type="button"
        role="tab"
        aria-controls="photos-panel"
        aria-selected="false"
        tabindex="-1"
        class="
          cursor-pointer rounded-t-lg rounded-b-none border-b-2 border-transparent px-1 py-3 text-sm font-medium
          transition focus-visible:rounded-lg focus-visible:outline focus-visible:outline-offset-1
          focus-visible:outline-neutral-700 sm:px-4 sm:text-base dark:focus-visible:outline-neutral-200
        "
        data-skatepark-tabs-target="tab"
        data-tab="photos"
        data-action="click->skatepark-tabs#switchTab keydown->skatepark-tabs#onKeydown"
      >
        <%= t("photos_tab", count: skatepark_images.size) %>
      </button>

      <button
        id="videos-tab"
        type="button"
        role="tab"
        aria-controls="videos-panel"
        aria-selected="false"
        tabindex="-1"
        class="
          cursor-pointer rounded-t-lg rounded-b-none border-b-2 border-transparent px-1 py-3 text-sm font-medium
          transition focus-visible:rounded-lg focus-visible:outline focus-visible:outline-offset-1
          focus-visible:outline-neutral-700 sm:px-4 sm:text-base dark:focus-visible:outline-neutral-200
        "
        data-skatepark-tabs-target="tab"
        data-tab="videos"
        data-action="click->skatepark-tabs#switchTab keydown->skatepark-tabs#onKeydown"
      >
        <%= t("videos_tab", count: skatepark_videos.size) %>
      </button>
    </div>

    <div
      id="photos-panel"
      role="tabpanel"
      aria-labelledby="photos-tab"
      data-skatepark-tabs-target="panel"
      data-tab="photos"
    >
      <%= photos_grid %>
    </div>

    <div
      id="videos-panel"
      role="tabpanel"
      aria-labelledby="videos-tab"
      class="hidden"
      data-skatepark-tabs-target="panel"
      data-tab="videos"
    >
      <%= videos_panel %>
    </div>

    <%= render "skateparks/video_suggestion_dialog", skatepark: @skatepark %>
  </div>

  <div
    class="fixed inset-0 z-10 hidden bg-neutral-700/95 px-4 py-16 md:px-16 md:py-16 lg:px-24 lg:py-24"
    data-skatepark-target="gallery"
    data-skatepark-announcement-pattern-value="<%= t('gallery_image_announcement', current: '{current}', total: '{total}') %>"
    role="dialog"
    aria-modal="true"
    aria-label="<%= t('image_gallery') %>"
  >
    <button
      type="button"
      class="
        absolute top-4 right-2 size-8 cursor-pointer text-white transition-opacity hover:opacity-75
        focus-visible:outline focus-visible:outline-2 focus-visible:outline-white md:top-8 md:right-8 lg:top-12
        lg:right-12 lg:size-12
      "
      data-action="click->skatepark#onModalClose"
      aria-label="<%= t('close_gallery') %>"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="h-full w-full"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18 18 6m0 12L6 6"
        />
      </svg>
    </button>

    <button
      type="button"
      class="
        absolute top-1/2 left-2 hidden h-14 w-14 -translate-y-1/2 cursor-pointer text-white transition-opacity
        hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white sm:block
        lg:left-6
      "
      data-action="click->skatepark#onPreviousGalleryImage"
      aria-label="<%= t('previous_image') %>"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="h-full w-full"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m15 19-7-7 7-7"
        />
      </svg>
    </button>

    <div class="relative flex h-full w-full items-center justify-center">
      <div
        class="sr-only"
        aria-live="polite"
        aria-atomic="true"
        data-skatepark-target="announcer"
      ></div>

      <% skatepark_images.each_with_index do |skatepark_image, index| %>
        <%= cl_image_tag skatepark_image.image.key,
        id: "galleryImage-#{index}",
        quality: :auto,
        fetch_format: :auto,
        class: "hidden object-contain w-full h-full",
        loading: "lazy",
        alt: t("skatepark.gallery_image_alt", name: @skatepark.name, current: index + 1, total: skatepark_images.length),
        data: {
          "skatepark-target": "galleryImage",
        } %>
      <% end %>

      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24"></div>

      <div
        class="absolute inset-x-0 bottom-6 flex flex-wrap items-center justify-center gap-3"
        role="group"
        aria-label="<%= t("skatepark.image_indicators") %>"
      >
        <% skatepark_images.each_with_index do |_, index| %>
          <button
            type="button"
            class="
              h-3 w-3 cursor-pointer rounded-full bg-white opacity-50 transition-all focus-visible:outline
              focus-visible:outline-2 focus-visible:outline-white sm:h-2 sm:w-2
            "
            id="indicatorImage-<%= index %>"
            data-action="click->skatepark#onGalleryImageIndicatorClick focus->skatepark#onGalleryImageIndicatorClick"
            data-skatepark-target="galleryImageIndicator"
            aria-label="<%= t('go_to_image', number: index + 1) %>"
          ></button>
        <% end %>
      </div>
    </div>

    <button
      type="button"
      class="
        absolute top-1/2 right-2 hidden h-14 w-14 -translate-y-1/2 cursor-pointer text-white transition-opacity
        hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white sm:block
        lg:right-6
      "
      data-action="click->skatepark#onNextGalleryImage"
      aria-label="<%= t('next_image') %>"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="h-full w-full"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m9 5 7 7-7 7"
        />
      </svg>
    </button>
  </div>

  <div
    class="fixed inset-0 z-10 hidden bg-neutral-700/95 px-4 py-16 md:px-16 md:py-16 lg:px-24 lg:py-24"
    data-skatepark-target="videoModal"
    role="dialog"
    aria-modal="true"
    aria-label="<%= t('video_player') %>"
  >
    <button
      type="button"
      class="
        absolute top-4 right-2 size-8 cursor-pointer text-white transition-opacity hover:opacity-75
        focus-visible:outline focus-visible:outline-2 focus-visible:outline-white md:top-8 md:right-8 lg:top-12
        lg:right-12 lg:size-12
      "
      data-action="click->skatepark#onVideoModalClose"
      aria-label="<%= t('close_video_player') %>"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        class="h-full w-full"
      >
        <path
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18 18 6m0 12L6 6"
        />
      </svg>
    </button>

    <% if skatepark_videos.many? %>
      <button
        type="button"
        class="
          absolute top-1/2 left-2 hidden h-14 w-14 -translate-y-1/2 cursor-pointer text-white transition-opacity
          hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white sm:block
          lg:left-6
        "
        data-action="click->skatepark#onPreviousVideo"
        aria-label="<%= t('previous_video') %>"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          class="h-full w-full"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m15 19-7-7 7-7"
          />
        </svg>
      </button>
    <% end %>

    <div class="relative flex h-full w-full items-center justify-center">
      <div class="w-full max-w-4xl">
        <iframe
          class="aspect-video w-full rounded-lg"
          data-skatepark-target="videoIframe"
          title="<%= t('video_player') %>"
          allow="autoplay; encrypted-media; picture-in-picture; fullscreen"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>

        <% if skatepark_videos.many? %>
          <div
            class="mt-6 flex flex-wrap items-center justify-center gap-3"
            role="group"
            aria-label="<%= t("skatepark.video_indicators") %>"
          >
            <% skatepark_videos.each_with_index do |_, index| %>
              <button
                type="button"
                class="
                  h-3 w-3 cursor-pointer rounded-full bg-white opacity-50 transition-all focus-visible:outline
                  focus-visible:outline-2 focus-visible:outline-white sm:h-2 sm:w-2
                "
                id="indicatorVideo-<%= index %>"
                data-action="click->skatepark#onVideoModalIndicatorClick focus->skatepark#onVideoModalIndicatorClick"
                data-skatepark-target="videoModalIndicator"
                aria-label="<%= t('go_to_video', number: index + 1) %>"
              ></button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <% if skatepark_videos.many? %>
      <button
        type="button"
        class="
          absolute top-1/2 right-2 hidden h-14 w-14 -translate-y-1/2 cursor-pointer text-white transition-opacity
          hover:opacity-75 focus-visible:outline focus-visible:outline-2 focus-visible:outline-white sm:block
          lg:right-6
        "
        data-action="click->skatepark#onNextVideo"
        aria-label="<%= t('next_video') %>"
      >
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          class="h-full w-full"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="m9 5 7 7-7 7"
          />
        </svg>
      </button>
    <% end %>
  </div>

  <div class="hidden sm:block">
    <div data-skatepark-target="container" class="leaflet-container z-0 rounded-lg" style="min-height: 450px"></div>
  </div>
</div>

<%= render(
  LinkComponent.new(
    title: t("back_to_skateparks"),
    url: skateparks_path,
    classnames:
      "flex flex-col sm:flex-row my-8 gap-4 items-center sm:items-start justify-end",
  ),
) %>
