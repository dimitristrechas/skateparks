<%= form_with url: skateparks_path, method: :get, class: 'flex flex-wrap items-end gap-4 mb-12', data: {
  controller: 'skateparks--filters'
} do |form| %>
  <%= form.hidden_field :locale, value: I18n.locale %>

  <%= render "country_select", countries: @countries %>

  <%= render "state_select", states: @states %>

  <div class="ms-0 flex items-center gap-4 xl:ms-8 xl:gap-6">
    <%= link_to t("reset_filters"), skateparks_path %>

    <%= form.button t("search"),
                type: "submit",
                class:
                  "py-2.5 px-5 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 cursor-pointer" %>
  </div>
<% end %>
