<div
  class="relative mb-8 sm:mb-12"
  data-controller="skateparks--filters skateparks--geolocation"
  data-skateparks--filters-cities-url-value="<%= available_cities_path %>"
  data-skateparks--geolocation-default-distance-value="<%= default_distance_filter %>"
  data-skateparks--geolocation-denied-message-value="<%= t("geolocation_denied") %>"
  data-skateparks--geolocation-unavailable-message-value="<%= t("geolocation_unavailable") %>"
  data-skateparks--geolocation-wait-for-location-message-value="<%= t("geolocation_wait") %>"
>
  <%= render "skatepark_sort" %>

  <details open class="group">
    <summary
      class="
        flex min-h-11 w-fit cursor-pointer list-none items-center gap-2 font-medium select-none group-open:mb-4
        focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2
        focus-visible:outline-neutral-700 dark:focus-visible:outline-neutral-200 [&::-webkit-details-marker]:hidden
      "
    >
      <svg
        class="size-5 transition-transform group-open:rotate-90"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>

      <%= t("filters") %>
    </summary>

    <%= form_with url: skateparks_path,
                  method: :get,
                  class: "clear-both flex flex-col gap-6 md:grid md:grid-cols-2 md:items-start lg:grid-cols-[14rem_14rem_minmax(0,1fr)_auto] lg:items-end lg:gap-x-6 lg:gap-y-2",
                  data: { action: "submit->skateparks--geolocation#handleSubmit" } do |form| %>
      <%= form.hidden_field :locale, value: I18n.locale, disabled: I18n.locale == I18n.default_locale %>

      <%= form.hidden_field :sort,
                            value: selected_sort_option,
                            disabled: selected_sort_option == "alphabetical" && selected_distance.blank?,
                            data: { "skateparks--geolocation-target": "filterSort" } %>

      <%= render "country_select", countries: countries %>
      <%= render "city_select", cities: cities %>

      <fieldset class="flex min-w-0 flex-col items-start gap-1 border-0 p-0 md:col-span-2 lg:col-span-1 lg:justify-self-start">
        <legend class="mb-1"><%= t("distance") %></legend>

        <div
          class="
            distance-filter relative grid w-full max-w-full grid-cols-4 items-stretch gap-1 overflow-hidden
            rounded-lg border border-neutral-300/90 p-1 lg:w-auto dark:border-neutral-600
          "
        >
          <div aria-hidden="true" class="distance-filter__indicator"></div>

          <% distance_filter_options.each do |distance| %>
            <% distance_value = distance.to_s %>
            <% distance_id = "distance_#{distance_value}" %>

            <div class="distance-filter__option">
              <%= radio_button_tag :distance,
                                   distance_value,
                                   selected_distance == distance_value,
                                   id: distance_id,
                                   class: "peer sr-only",
                                   data: {
                                     action: "change->skateparks--geolocation#selectDistance",
                                     "skateparks--geolocation-target": "distanceRadio"
                                   } %>

              <%= label_tag distance_id, t("within_distance", distance: distance), class: segmented_option_classes("px-2 sm:px-4") %>
            </div>
          <% end %>

          <div class="distance-filter__option">
            <%= radio_button_tag :distance,
                                 "",
                                 selected_distance.blank?,
                                 id: "distance_all",
                                 class: "peer sr-only",
                                 data: {
                                   action: "change->skateparks--geolocation#selectDistance",
                                   "skateparks--geolocation-target": "distanceRadio"
                                 } %>

            <%= label_tag "distance_all", t("all_distances"), class: segmented_option_classes("px-2 sm:px-4") %>
          </div>
        </div>

        <%= form.hidden_field :lat,
                              value: params[:lat],
                              disabled: !coordinates_valid? || (selected_distance.blank? && selected_sort_option != "nearest"),
                              data: { "skateparks--geolocation-target": "latitude" } %>

        <%= form.hidden_field :lng,
                              value: params[:lng],
                              disabled: !coordinates_valid? || (selected_distance.blank? && selected_sort_option != "nearest"),
                              data: { "skateparks--geolocation-target": "longitude" } %>
      </fieldset>

      <div class="flex flex-wrap items-center gap-4 md:col-span-2 md:justify-end lg:col-span-1 lg:col-start-4 lg:row-start-1">
        <%= render LinkButtonComponent.new(
          title: t("reset_filters"),
          url: skateparks_path(
            sort: selected_sort_option == "alphabetical" ? nil : selected_sort_option,
            lat: selected_sort_option == "nearest" ? params[:lat] : nil,
            lng: selected_sort_option == "nearest" ? params[:lng] : nil
          )
        ) %>

        <%= render ButtonComponent.new(title: t("search"), type: :submit, form:, large: true) %>
      </div>
    <% end %>
  </details>

  <p
    class="clear-both mt-1.5 text-xs text-neutral-500 dark:text-neutral-400"
    data-skateparks--geolocation-target="message"
    role="status"
    aria-live="polite"
    hidden
  ></p>
</div>
