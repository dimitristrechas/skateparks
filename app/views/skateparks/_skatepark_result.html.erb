<%= link_to skatepark_path(skatepark),
                id: dom_id(skatepark),
                class: "flex flex-col items-stretch border border-neutral-300 w-full rounded-lg hover:drop-shadow-md md:flex-row dark:border-neutral-500" do %>
  <%= cl_image_tag skatepark.cover_image.key,
  size: "600x450",
  fetchpriority: "high",
  class:
    "object-cover w-full h-80 md:w-3/5 -skew-y-1 origin-bottom-left rounded-lg shadow-lg",
  alt: t("skatepark.cover_image_alt", name: skatepark.name),
  **CLOUDINARY_DEFAULT_SETTINGS %>

  <div
    class="
      flex flex-1 flex-col items-start justify-between overflow-hidden p-4 leading-normal sm:justify-start sm:py-8
      sm:ps-6
    "
  >
    <h5 class="text-2xl font-bold tracking-tight sm:mb-3"><%= skatepark.name %></h5>

    <% skatepark_details = ["#{skatepark.skatepark_images.size} #{t("photos")}"] %>

    <% if skatepark.skatepark_videos_count.positive? %>
      <% skatepark_details << "#{skatepark.skatepark_videos_count} #{t("videos")}" %>
    <% end %>

    <% distance_label =
       if (distance = skatepark.try(:distance)).present?
         t("km_away", distance: number_with_precision(distance, precision: 1, strip_insignificant_zeros: true))
       end %>

    <p class="font-normal sm:mb-1"><%= skatepark_details.join(" · ") %></p>

    <% if distance_label.present? %>
      <p class="mt-1 font-normal"><%= distance_label %></p>
    <% end %>
  </div>
<% end %>
