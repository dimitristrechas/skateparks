<%= link_to skatepark_path(skatepark),
                id: dom_id(skatepark),
                class: "flex flex-col items-stretch bg-neutral-50 border border-gray-200 w-full rounded-lg hover:drop-shadow-md md:flex-row dark:border-gray-700 dark:bg-gray-800" do %>
  <%= cl_image_tag skatepark.cover_image.key,
  size: "600x450",
  class:
    "object-cover w-full h-80 md:w-3/5 -skew-y-1 origin-bottom-left rounded-lg shadow-lg",
  alt: "#{skatepark.name} cover image",
  **CLOUDINARY_DEFAULT_SETTINGS %>
  <div
    class="
      flex flex-1 overflow-hidden flex-col justify-between sm:justify-start
      items-start p-4 sm:py-8 sm:ps-6 leading-normal
    "
  >
    <h5
      class="
        sm:mb-3 text-2xl lg:max-xl:text-xl xl:text-2xl font-bold tracking-tight
        text-neutral-700 dark:text-neutral-200
      "
    >
      <%= skatepark.name %>
    </h5>
    <p class="sm:mb-1 font-normal">
      <%= "#{skatepark.images.size} #{t("photos")}" %>
    </p>
    <svg
      class="w-6 h-6 sm:mt-auto self-end hover:w-7 hover:h-7 transition-all"
      aria-hidden="true"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 16 16"
    >
      <path
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M11 1h4m0 0v4m0-4-5 5.243M5 15H1m0 0v-4m0 4 5.243-5"
      />
    </svg>
  </div>
<% end %>
