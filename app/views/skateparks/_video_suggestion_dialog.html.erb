<dialog
  id="<%= dom_id(skatepark, :video_suggestion_dialog) %>"
  class="
    video-suggestion-dialog w-[min(100%,32rem)] rounded-lg border border-neutral-200 bg-white p-0 shadow-xl
    dark:border-neutral-700 dark:bg-neutral-800
  "
  data-skatepark-video-suggestion-target="dialog"
  aria-labelledby="<%= dom_id(skatepark, :video_suggestion_title) %>"
>
  <div class="p-4">
    <div class="mb-2 flex items-center justify-between gap-4">
      <h2
        id="<%= dom_id(skatepark, :video_suggestion_title) %>"
        class="text-xl font-semibold text-neutral-900 dark:text-white"
      >
        <%= t("skateparks.video_suggestion.dialog_title") %>
      </h2>

      <form method="dialog" class="shrink-0">
        <button
          type="submit"
          class="
            inline-flex size-11 cursor-pointer items-center justify-center rounded-lg text-neutral-600 transition
            hover:outline-2 hover:outline-offset-2 hover:outline-neutral-700 focus-visible:outline-2
            focus-visible:outline-offset-2 focus-visible:outline-neutral-700 dark:text-neutral-300
            dark:hover:outline-neutral-200 dark:focus-visible:outline-neutral-200
          "
          data-action="click->skatepark-video-suggestion#close"
          aria-label="<%= t('skateparks.video_suggestion.close_dialog') %>"
        >
          <svg
            aria-hidden="true"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="size-5"
          >
            <path
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18 18 6m0 12L6 6"
            />
          </svg>
        </button>
      </form>
    </div>

    <p class="mb-6 text-sm text-neutral-600 dark:text-neutral-300">
      <%= t("skateparks.video_suggestion.instructions") %>
    </p>

    <%= form_with url: skatepark_video_suggestion_path(skatepark),
                  scope: :video_suggestion,
                  data: {
                    turbo: true,
                    skatepark_video_suggestion_target: "form",
                    action: "submit->skatepark-video-suggestion#validateBeforeSubmit",
                  } do |form| %>
      <div class="sr-only" aria-hidden="true">
        <%= form.label :website, t("skateparks.video_suggestion.honeypot_label") %>

        <%= form.text_field :website, tabindex: "-1", autocomplete: "off",
                            data: { skatepark_video_suggestion_target: "honeypot" } %>
      </div>

      <div class="mb-4">
        <%= form.label :youtube_url, t("skateparks.video_suggestion.url_label"),
                       class: "mb-1 block text-sm font-medium text-neutral-700 dark:text-neutral-200" %>

        <%= form.url_field :youtube_url,
                           required: true,
                           inputmode: "url",
                           autocomplete: "url",
                           maxlength: 255,
                           placeholder: t("skateparks.video_suggestion.url_placeholder"),
                           class: "w-full rounded-lg border-neutral-300 p-2 text-neutral-700 dark:border-neutral-600 dark:bg-neutral-700 dark:text-neutral-100",
                           data: {
                             skatepark_video_suggestion_target: "urlInput",
                             action: "input->skatepark-video-suggestion#clearUrlError",
                           } %>

        <p
          id="<%= dom_id(skatepark, :video_suggestion_error) %>"
          class="mt-2 hidden text-sm text-red-600 dark:text-red-400"
          data-skatepark-video-suggestion-target="error"
          role="alert"
        ></p>
      </div>

      <div
        class="mb-4"
        aria-live="polite"
        aria-atomic="true"
        data-skatepark-video-suggestion-target="announcer"
      >
        <%= render "skateparks/video_suggestion_feedback", skatepark: skatepark %>
      </div>

      <div class="flex justify-end gap-3">
        <button
          type="button"
          class="
            inline-flex min-h-11 cursor-pointer items-center rounded-lg px-4 py-2 text-neutral-700 transition
            hover:outline hover:outline-offset-1 hover:outline-neutral-700 focus-visible:outline
            focus-visible:outline-offset-1 focus-visible:outline-neutral-700 dark:text-neutral-200
            dark:hover:outline-neutral-200 dark:focus-visible:outline-neutral-200
          "
          data-action="click->skatepark-video-suggestion#close"
        >
          <%= t("cancel") %>
        </button>

        <%= render(
          ButtonComponent.new(
            title: t("skateparks.video_suggestion.submit"),
            form: form,
            type: "submit",
          ),
        ) %>
      </div>
    <% end %>
  </div>
</dialog>
