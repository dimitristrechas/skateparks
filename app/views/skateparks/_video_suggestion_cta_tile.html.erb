<button
  type="button"
  class="
    group relative flex h-full w-full cursor-pointer flex-col items-center justify-center gap-3 overflow-hidden
    bg-transparent p-4 text-neutral-600 transition hover:border-pink-500 hover:text-pink-600 focus-visible:outline
    focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-neutral-700
    dark:border-neutral-500/80 dark:text-neutral-300 dark:hover:border-pink-500 dark:hover:text-pink-400
    dark:focus-visible:outline-neutral-200
  "
  data-action="click->skatepark-video-suggestion#open"
  aria-haspopup="dialog"
  aria-controls="<%= dom_id(skatepark, :video_suggestion_dialog) %>"
>
  <svg
    aria-hidden="true"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    class="size-8 shrink-0 transition group-hover:scale-105 sm:size-12 md:size-14"
  >
    <path stroke-linecap="round" d="M12 6v12M6 12h12" />
  </svg>

  <span class="text-center text-sm font-medium sm:text-base md:text-lg">
    <%= t("skateparks.video_suggestion.cta") %>
  </span>
</button>
