<header><%= link_to 'homepage', root_path, class: 'text-blue-500 underline' %></header>


<h1>Skateparks</h1>

<div id="skateparks">
  <% @skateparks.each do |skatepark| %>
    <%= render skatepark %>
    <p>
      <%= link_to "Show this skatepark", skatepark, class: 'text-blue-500 underline' %>
    </p>
  <% end %>
</div>

