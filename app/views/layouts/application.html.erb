<!DOCTYPE html>

<html lang="<%= I18n.locale %>">
  <head>
    <%= render partial: "/application/title" %>
    <%= render partial: "/application/description" %>

    <% if content_for?(:meta_robot) %>
      <%= yield :meta_robot %>
    <% else %>
      <meta name="robots" content="index, follow">
    <% end %>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <meta property="og:title" content="<%= @title.blank? ? t("application.title") : @title %>">

    <meta property="og:site_name" content="Skateparks.gr">

    <meta
      property="og:description"
      content="<%= @meta_description.blank? ? t('application.meta_description') : @meta_description %>"
    >

    <meta property="og:type" content="website">

    <meta property="og:image" content="<%= @meta_image.blank? ? image_url("logo-og.png") : @meta_image %>">

    <meta property="og:url" content="<%= url_for(:only_path => false, :protocol => 'https') %>">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="canonical" href="<%= request.base_url + request.path %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= json_ld_schema(
      skatepark: defined?(@skatepark) ? @skatepark : nil,
      skateparks: defined?(@skateparks) ? @skateparks : nil,
      title: @title,
      meta_description: @meta_description,
      meta_image: @meta_image,
    ) %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    >

    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700&display=swap" rel="stylesheet">
    </noscript>

    <%= stylesheet_link_tag "tailwind",
    "trix",
    "actiontext",
    "data-turbo-track": "reload" %>

    <%= yield :head if content_for?(:head) %>

    <%= javascript_importmap_tags %>
    <%= favicon_link_tag asset_path("favicon/favicon.ico") %>

    <script>
      function applyTheme() {
        if (
          localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      applyTheme();

      window.addEventListener('pageshow', (e) => {
          if (e.persisted) applyTheme();
      })
    </script>

    <% if Rails.env.production? && !request.path.start_with?("/admin") %>
      <script
        src="https://umami.dimitristrechas.com/script.js"
        defer
        data-website-id="8069aac7-fcfc-4784-bd61-6616285973fd"
      >
      </script>
    <% end %>

    <% if cookie_consent_enabled? %>
      <%= render "application/posthog" %>
    <% end %>

    <meta name="view-transition" content="same-origin">
  </head>

  <body
    class="
      container mx-auto grid min-h-screen grid-rows-layout bg-neutral-100 p-4 text-neutral-700 md:p-6 2xl:px-0
      dark:bg-neutral-800 dark:text-neutral-200
    "
    <% if cookie_consent_enabled? %>
      data-controller="posthog"
      data-posthog-api-key-value="<%= ENV["POSTHOG_API_KEY"] %>"
      data-posthog-api-host-value="https://t.skateparks.gr"
      data-posthog-ui-host-value="https://eu.posthog.com"
    <% end %>
  >
    <%= render "home/header" %>

    <main><%= yield %></main>

    <%= render "home/footer" %>

    <% if cookie_consent_enabled? %>
      <%= render CookieConsentBannerComponent.new %>
    <% end %>
  </body>
</html>
