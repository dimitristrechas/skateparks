<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render partial: "/application/title" %>
    <meta id="head-description-meta" name="description" itemprop="description" content="<%= @meta_description.blank? ? 'Όλα τα skateparks της Ελλάδας μαζεμένα εδώ!': @meta_description %>">

    <% if content_for?(:meta_robot) %>
      <%= yield :meta_robot %>
    <% else %>
      <meta name="robots" content="index, follow">
    <% end %>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css",
                            integrity: "sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=",
                            crossorigin: "" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag asset_path('favicon/favicon.ico') %>

    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

    </script>
  </head>

  <body class="grid grid-rows-layout min-h-screen container mx-auto py-4 md:py-6 px-2 md:px-4 2xl:px-0 dark:bg-neutral-800 bg-neutral-100 text-neutral-600 dark:text-neutral-300">
    <%= render "home/header" %>

    <main>
      <%= yield %>
    </main>

    <%= render "home/footer" %>
  </body>
</html>
