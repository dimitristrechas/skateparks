<!DOCTYPE html>
<html lang="en">
  <head>
    <title>skateparks.gr</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Skateparks.gr - List of all skateparks in Greece">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag asset_path('favicon/favicon.ico') %>

    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }

    </script>
  </head>

  <body class="h-screen container mx-auto my-6 px-4 2xl:px-0 flex flex-col dark:bg-neutral-800 bg-neutral-100 text-neutral-600 dark:text-neutral-300">
    <%= render "home/header" %>

    <main>
      <%= yield %>
    </main>

    <%= render "home/footer" %>
  </body>
</html>
