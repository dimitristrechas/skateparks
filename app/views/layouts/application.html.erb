<!DOCTYPE html>
<html lang="<%= I18n.locale %>" itemscope itemtype="https://schema.org/WebPage">
  <head>
    <%= render partial: "/application/title" %>
    <%= render partial: "/application/description" %>

    <% if content_for?(:meta_robot) %>
      <%= yield :meta_robot %>
    <% else %>
      <meta name="robots" content="index, follow">
    <% end %>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <meta
      property="og:title"
      itemprop="name"
      content="<%= @title.blank? ? t("application.title") : @title %>"
    >
    <meta property="og:site_name" content="Skateparks.gr">
    <meta
      property="og:description"
      content="<%= @meta_description.blank? ? t('application.meta_description') : @meta_description %>"
    >
    <meta property="og:type" content="website">
    <meta
      property="og:image"
      content="<%= @meta_image.blank? ? image_url("og_image.png") : @meta_image %>"
    >
    <meta
      property="og:url"
      content="<%= url_for(:only_path => false, :protocol => 'https') %>"
    />

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="<%= request.base_url + request.path %>"/>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "trix", "actiontext", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css",
    integrity: "sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=",
    crossorigin: "" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag asset_path("favicon/favicon.ico") %>

    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <%= if Rails.env.production? && !request.path.start_with?("/admin")
      javascript_include_tag "https://analytics.dimitristrechas.com/script.js",
      defer: true,
      "data-website-id": "8069aac7-fcfc-4784-bd61-6616285973fd"
    end %>
  </head>

  <body
    class="
      grid grid-rows-layout min-h-screen container mx-auto py-4 md:py-6 px-2 md:px-4
      2xl:px-0 dark:bg-neutral-800 bg-neutral-100 text-neutral-600
      dark:text-neutral-300
    "
  >
    <%= render "home/header" %>

    <main>
      <%= yield %>
    </main>

    <%= render "home/footer" %>
  </body>
</html>
