<!DOCTYPE html>
<html lang="en">
  <head>
    <title>skateparks.gr</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Skateparks.gr - List of all skateparks in Greece">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= favicon_link_tag asset_path('favicon/favicon.ico') %>

    <script>
      if (
        localStorage.theme === "dark" ||
        (!("theme" in localStorage) &&
          window.matchMedia("(prefers-color-scheme: dark)").matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>

  <body class="container mx-auto mt-2 px-5 flex-row">
    <header>
      <%= image_tag("skateparks_logo_dark.svg", height: '161', width: '834', alt: 'skateparks.gr logo') %>

      <%= render "static/dark_mode" %>
    </header>
    <main>
      <%= yield %>
    </main>
  </body>
</html>
