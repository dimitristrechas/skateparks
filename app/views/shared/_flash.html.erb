<% if alert = flash[:alert] %>
  <div role="alert" class="mb-5 rounded-lg bg-red-50 px-3 py-2 font-medium text-red-500" id="alert"><%= alert %></div>
<% end %>

<% if notice = flash[:notice] %>
  <div
    role="status"
    aria-live="polite"
    class="mb-5 rounded-lg bg-green-50 px-3 py-2 font-medium text-green-700"
    id="notice"
  >
    <%= notice %>
  </div>
<% end %>
