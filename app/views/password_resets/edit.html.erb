<div class="mx-auto md:w-2/3 w-full">
  <%= render "shared/flash" %>

  <h1 class="font-bold text-4xl"><%= t('passwords.edit_title') %></h1>

  <%= form_with url: password_reset_path(params[:token]), method: :put, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.label :password, t('passwords.password_label'), class: "block font-medium" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", placeholder: t('passwords.password_placeholder'), maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline focus:outline-2 focus:outline-blue-600 px-3 py-2 mt-2 w-full text-gray-900 bg-white dark:text-white dark:bg-gray-700 dark:border-gray-600" %>
    </div>

    <div class="my-5">
      <%= form.label :password_confirmation, t('passwords.password_confirmation_label'), class: "block font-medium" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t('passwords.password_confirmation_placeholder'), maxlength: 72, class: "block shadow-sm rounded-md border border-gray-400 focus:outline focus:outline-2 focus:outline-blue-600 px-3 py-2 mt-2 w-full text-gray-900 bg-white dark:text-white dark:bg-gray-700 dark:border-gray-600" %>
    </div>

    <div class="inline">
      <%= form.submit t('passwords.save'), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
    </div>
  <% end %>
</div>
