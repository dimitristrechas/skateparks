<%= link_to @url,
            target: @target,
            rel: (@target == '_blank' ? 'noopener noreferrer' : nil),
            aria: (@current ? { current: 'page' } : nil),
            class: class_names(base_classes, current_classes, contained_classes, ghost_classes, large_classes, @classnames) do %>
  <span class="flex items-center gap-2 text-center">
    <%= icon_before if icon_before? %>
    <%= @title %>
    <%= icon_after if icon_after? %>
  </span>

  <% if @target == '_blank' %>
    <span class="sr-only"><%= t('opens_in_new_tab') %></span>
  <% end %>
<% end %>
