<div
  data-posthog-target="banner"
  role="region"
  aria-label="<%= t('cookie_consent.aria_label') %>"
  tabindex="-1"
  class="
    hidden fixed inset-x-0 bottom-0 z-50 border-t border-neutral-400 bg-neutral-100 p-4 shadow-lg
    dark:border-neutral-700 dark:bg-neutral-800
  "
>
  <div class="container mx-auto flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm"><%= t('cookie_consent.message') %></p>

    <div class="flex shrink-0 flex-wrap gap-3">
      <%= render LinkButtonComponent.new(
            title: t('cookie_consent.learn_more'),
            url: privacy_path,
            ghost: true
          ) %>

      <%= render ButtonComponent.new(
            title: t('cookie_consent.reject'),
            type: 'button',
            ghost: true,
            data: { action: 'click->posthog#reject' }
          ) %>

      <%= render ButtonComponent.new(
            title: t('cookie_consent.accept'),
            type: 'button',
            data: { action: 'click->posthog#accept' }
          ) %>
    </div>
  </div>
</div>
