<%= link_to skatepark_path(@skatepark), class: "flex" do %>
  <div class="relative size-40 shrink-0 overflow-hidden rounded-full lg:size-48">
    <%= helpers.cl_image_tag @skatepark.cover_image.key,
                     size: "160x160",
                     class: "size-40 lg:size-48 object-cover rounded-full transition-transform",
                     alt: t("skatepark.cover_image_alt", name: @skatepark.name),
                     fetchpriority: "high",
                     **CLOUDINARY_DEFAULT_SETTINGS %>

    <div class="absolute inset-x-0 bottom-0 bg-green-950/50 py-2 text-center text-neutral-300">
      <%= t(@badge_type) %>
    </div>
  </div>

  <div class="min-w-40 py-2 ps-6">
    <h2 class="text-lg"><%= @skatepark.name %></h2>
    <% media_counts = ["#{@skatepark.skatepark_images.size} #{t("photos")}"] %>

    <% if @skatepark.skatepark_videos_count.positive? %>
      <% media_counts << "#{@skatepark.skatepark_videos_count} #{t("videos")}" %>
    <% end %>

    <p><%= media_counts.join(" · ") %></p>
  </div>
<% end %>
