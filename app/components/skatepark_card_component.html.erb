<%= link_to skatepark_path(@skatepark), class: "flex" do %>
  <div class="relative size-40 lg:size-48 overflow-hidden rounded-full shrink-0">
    <%= cl_image_tag @skatepark.cover_image.key,
                     size: "160x160",
                     class: "size-40 lg:size-48 object-cover rounded-full transition-transform",
                     alt: "#{@skatepark.name} cover image",
                     **CLOUDINARY_DEFAULT_SETTINGS %>
    <div class="absolute bottom-0 inset-x-0 py-2 text-center bg-green-950/50"><%= t(@badge_type) %></div>
  </div>
  <div class="ps-6 py-2 min-w-40">
    <h3 class="text-lg"> <%= @skatepark.name %></h3>
    <p><%= "#{@skatepark.images.size} #{t("photos")}" %></p>
  </div>
<% end %>
