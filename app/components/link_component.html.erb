<%= link_to @url,
            target: @target,
            rel: (@target == '_blank' ? 'noopener noreferrer' : nil),
            aria: (@current ? { current: 'page' } : nil),
            class: class_names(base_classes, current_classes, @classnames) do %>
  <%= @title %>

  <% if @target == '_blank' %>
    <span class="sr-only"><%= t('opens_in_new_tab') %></span>
  <% end %>
<% end %>
