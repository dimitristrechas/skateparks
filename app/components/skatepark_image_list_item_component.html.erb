<div
  class="<%= item_classes %>"
  data-sortable-item
  data-destroyed="<%= @destroyed %>"
  role="listitem"
>
  <%= fields if fields? %>

  <div class="flex items-center gap-3">
    <button
      type="button"
      class="
        inline-flex size-11 shrink-0 cursor-grab items-center justify-center rounded-lg text-neutral-400 transition
        hover:outline hover:outline-offset-1 hover:outline-neutral-700 focus-visible:outline
        focus-visible:outline-offset-1 focus-visible:outline-neutral-700 dark:text-neutral-500
        hover:dark:outline-neutral-200 dark:focus-visible:outline-neutral-200
      "
      data-sort-handle
      aria-label="<%= handle_label %>"
      aria-roledescription="sortable"
    >
      <span class="sr-only">Drag to reorder</span>

      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
        class="size-5"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M8 6h8M8 12h8M8 18h8" />
      </svg>
    </button>

    <%= preview if preview? %>
  </div>

  <div class="min-w-0 flex-1">
    <p class="font-medium text-neutral-700 dark:text-neutral-200">
      Image <span data-position-label><%= position_label %></span>
    </p>

    <%= subtitle if subtitle? %>
  </div>

  <div class="flex flex-wrap items-center gap-2 sm:justify-end">
    <button
      type="button"
      class="
        inline-flex size-11 items-center justify-center rounded-lg text-neutral-600 outline outline-gray-400
        transition hover:outline-neutral-700 focus-visible:outline focus-visible:outline-neutral-700
        disabled:opacity-50 dark:text-neutral-300 dark:outline-gray-500 dark:hover:outline-neutral-200
        dark:focus-visible:outline-neutral-200
      "
      data-action="click->admin--skateparks--form#moveUp"
      data-move-up-button
      aria-label="<%= move_up_label %>"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        class="size-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m5 15 7-7 7 7"
        />
      </svg>
    </button>

    <button
      type="button"
      class="
        inline-flex size-11 items-center justify-center rounded-lg text-neutral-600 outline outline-gray-400
        transition hover:outline-neutral-700 focus-visible:outline focus-visible:outline-neutral-700
        disabled:opacity-50 dark:text-neutral-300 dark:outline-gray-500 dark:hover:outline-neutral-200
        dark:focus-visible:outline-neutral-200
      "
      data-action="click->admin--skateparks--form#moveDown"
      data-move-down-button
      aria-label="<%= move_down_label %>"
    >
      <svg
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        class="size-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="m19 9-7 7-7-7"
        />
      </svg>
    </button>

    <button
      type="button"
      class="
        inline-flex min-h-11 items-center rounded-lg px-3 text-sm text-red-600 transition hover:outline
        hover:outline-offset-1 hover:outline-red-500 focus-visible:outline focus-visible:outline-offset-1
        focus-visible:outline-red-500 dark:text-red-400
      "
      data-action="click->admin--skateparks--form#removeImage"
      data-delete-button
      aria-label="<%= delete_label %>"
    >
      Delete
    </button>
  </div>
</div>
