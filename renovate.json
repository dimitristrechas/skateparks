{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:allNonMajor"],
  "labels": ["dependencies"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "One weekly PR for all minor/patch/pin/digest updates across gems, npm, Actions, and Docker",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    },
    {
      "description": "Group major Ruby updates (gems, .ruby-version, Ruby Docker tags)",
      "matchUpdateTypes": ["major"],
      "matchManagers": ["bundler", "ruby-version", "dockerfile"],
      "matchPackageNames": ["ruby"],
      "groupName": "Ruby (major)",
      "groupSlug": "major-ruby"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchManagers": ["npm", "nodenv", "nvm"],
      "groupName": "npm packages (major)",
      "groupSlug": "major-npm-packages"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions (major)",
      "groupSlug": "major-github-actions"
    },
    {
      "matchUpdateTypes": ["major"],
      "matchManagers": ["docker-compose", "dockerfile"],
      "groupName": "Docker images (major)",
      "groupSlug": "major-docker-images",
      "matchPackageNames": ["!ruby"]
    },
    {
      "matchPackageNames": ["renovatebot/github-action"],
      "extends": ["schedule:weekly"]
    }
  ]
}
