{
  "dependencies": {
    "@rails/actiontext": "8.1.301",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "flowbite": "4.0.2",
    "trix": "2.1.19"
  },
  "devDependencies": {
    "@herb-tools/formatter": "^0.10.0",
    "@herb-tools/linter": "^0.10.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "herb:lint": "herb-lint",
    "herb:lint:fix": "herb-lint --fix",
    "herb:format": "herb-format 'app/views/**/*.erb' 'app/components/**/*.erb'",
    "herb:format:check": "herb-format --check 'app/views/**/*.erb' 'app/components/**/*.erb'",
    "prettier:check": "prettier --check '**/*.{js,ts,json,css}'",
    "prettier:fix": "prettier --write '**/*.{js,ts,json,css}'"
  }
}
