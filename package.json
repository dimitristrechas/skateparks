{
  "dependencies": {
    "@rails/actiontext": "8.1.300",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "flowbite": "2.5.2",
    "trix": "2.1.18"
  },
  "devDependencies": {
    "@herb-tools/formatter": "^0.8.6",
    "@herb-tools/linter": "^0.8.6",
    "prettier": "^3.6.2"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "dompurify": ">=3.4.9",
    "picomatch": "^4.0.4",
    "postcss": ">=8.5.10",
    "yaml": "^2.8.3"
  },
  "scripts": {
    "herb:lint": "herb-lint",
    "herb:lint:fix": "herb-lint --fix",
    "herb:format": "herb-format 'app/views/**/*.erb' 'app/components/**/*.erb'",
    "herb:format:check": "herb-format --check 'app/views/**/*.erb' 'app/components/**/*.erb'",
    "prettier:check": "prettier --check '**/*.{js,ts,json,css}'",
    "prettier:fix": "prettier --write '**/*.{js,ts,json,css}'"
  }
}
