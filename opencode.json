{
  "agent": {
    "rails-implementer": {
      "description": "Implement or refactor Rails app code — models, controllers, jobs, ViewComponents, Stimulus, Tailwind. Use for feature work spanning backend and UI.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:./.claude/agents/rails-implementer.md}"
    },
    "devops": {
      "description": "Docker, scripts.sh, CI/CD, credentials, environment setup, and deployment troubleshooting.",
      "mode": "subagent",
      "temperature": 0.1,
      "prompt": "{file:./.claude/agents/devops.md}"
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_TOKEN}"
      }
    },
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:LINEAR_MCP_TOKEN}"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "enabled": true,
      "oauth": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:CONTEXT7_API_KEY}"
      }
    }
  },
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash(git commit*)": "ask",
    "bash(git push*)": "ask",
    "bash(git reflog*)": "ask",
    "bash(git reset*)": "ask",
    "skill": {
      "*": "allow"
    }
  }
}
